#!/bin/sh
# Git hook: verify WP8.1 after a successful pull/merge and publish the result
# to GitHub using curl and GITHUB_TOKEN. No GitHub CLI is required.

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

echo ""
echo "========================================"
echo " Git: WP8.1 build verification"
echo "========================================"

if [ ! -f ".vscode/build-debug.ps1" ]; then
  echo "[Git] ERROR: .vscode/build-debug.ps1 not found."
  exit 1
fi

if ! command -v powershell.exe >/dev/null 2>&1; then
  echo "[Git] ERROR: powershell.exe not found."
  echo "[Git] Install/use Git for Windows on the Windows build machine."
  exit 1
fi

COMMIT_SHA="$(git rev-parse HEAD)"
REPO="yasn198020-jpg/ESP32-AI-Control-WP81"
STATUS_CONTEXT="WP8.1 / Debug ARM"

publish_status() {
  STATE="$1"
  DESCRIPTION="$2"

  if [ -z "$GITHUB_TOKEN" ]; then
    echo "[GitHub] GITHUB_TOKEN is not configured; build result remains local."
    return 0
  fi

  if ! command -v curl.exe >/dev/null 2>&1; then
    echo "[GitHub] curl.exe not found; build result remains local."
    return 0
  fi

  echo "[GitHub] Publishing commit status: $STATE"

  BODY="{\"state\":\"$STATE\",\"target_url\":\"https://github.com/$REPO/commit/$COMMIT_SHA\",\"description\":\"$DESCRIPTION\",\"context\":\"$STATUS_CONTEXT\"}"

  if ! curl.exe -sS -o NUL -w "%{http_code}" \
      -X POST \
      -H "Accept: application/vnd.github+json" \
      -H "Authorization: Bearer $GITHUB_TOKEN" \
      -H "X-GitHub-Api-Version: 2022-11-28" \
      "https://api.github.com/repos/$REPO/statuses/$COMMIT_SHA" \
      -d "$BODY" | grep -q '^201$'; then
    echo "[GitHub] WARNING: could not publish commit status."
    echo "[GitHub] Check that GITHUB_TOKEN is valid and has commit-status permission."
  fi
}

powershell.exe -NoProfile -ExecutionPolicy Bypass -File ".vscode/build-debug.ps1"
RESULT=$?

if [ $RESULT -ne 0 ]; then
  echo ""
  echo "========================================"
  echo " BUILD FAILED"
  echo "========================================"
  publish_status "failure" "WP8.1 Debug ARM build failed"
  exit $RESULT
fi

echo ""
echo "========================================"
echo " BUILD OK"
echo "========================================"
publish_status "success" "WP8.1 Debug ARM build passed"
exit 0
