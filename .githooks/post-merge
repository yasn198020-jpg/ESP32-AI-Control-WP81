#!/bin/sh
# Git hook: verify WP8.1 after a successful pull/merge and publish the result
# as a GitHub commit status when GitHub CLI authentication is available.

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

echo ""
echo "========================================"
echo " Git: WP8.1 build verification"
echo "========================================"

if [ ! -f ".vscode/build-debug.ps1" ]; then
  echo "[Git] ERROR: .vscode/build-debug.ps1 not found."
  exit 1
fi

if ! command -v powershell.exe >/dev/null 2>&1; then
  echo "[Git] ERROR: powershell.exe not found."
  echo "[Git] Install/use Git for Windows on the Windows build machine."
  exit 1
fi

COMMIT_SHA="$(git rev-parse HEAD)"
REPO="yasn198020-jpg/ESP32-AI-Control-WP81"
STATUS_CONTEXT="WP8.1 / Debug ARM"

publish_status() {
  STATE="$1"
  DESCRIPTION="$2"

  # Publishing is optional: it must never hide the real build result.
  if command -v gh >/dev/null 2>&1; then
    echo "[GitHub] Publishing commit status: $STATE"
    if ! gh api       --method POST       "repos/$REPO/statuses/$COMMIT_SHA"       -f "state=$STATE"       -f "context=$STATUS_CONTEXT"       -f "description=$DESCRIPTION"       -f "target_url=https://github.com/$REPO/commit/$COMMIT_SHA"       >/dev/null 2>&1; then
      echo "[GitHub] WARNING: could not publish status."
      echo "[GitHub] Run 'gh auth login' once on this PC."
    fi
  else
    echo "[GitHub] gh CLI not found; build result remains local."
    echo "[GitHub] Install GitHub CLI and run 'gh auth login' to publish status."
  fi
}

powershell.exe -NoProfile -ExecutionPolicy Bypass -File ".vscode/build-debug.ps1"
RESULT=$?

if [ $RESULT -ne 0 ]; then
  echo ""
  echo "========================================"
  echo " BUILD FAILED"
  echo "========================================"
  publish_status "failure" "WP8.1 Debug ARM build failed"
  exit $RESULT
fi

echo ""
echo "========================================"
echo " BUILD OK"
echo "========================================"
publish_status "success" "WP8.1 Debug ARM build passed"
exit 0
