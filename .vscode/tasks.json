      "group":{"kind":"build","isDefault":true},
      "problemMatcher":"$msCompile"
    },
    {
      "label":"WP8.1: Build Release ARM",
      "type":"shell",
      "command":"powershell.exe",
      "args":["-NoProfile","-ExecutionPolicy","Bypass","-File","${workspaceFolder}\\.vscode\\build-debug.ps1","-BuildConfiguration","Release"],
      "options":{"cwd":"${workspaceFolder}"},
      "problemMatcher":"$msCompile"
    }
  ]
}