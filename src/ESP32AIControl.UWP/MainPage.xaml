<Page
    x:Class="ESP32AIControl.UWP.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource AppBackgroundBrush}"
    RequestedTheme="Dark">

    <Page.Resources>
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="2,6"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="MenuItemButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="76"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource AppBackgroundBrush}"
                BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="38"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="MenuButton" Grid.Column="0" Content="☰"
                        Click="MenuButton_Click" FontSize="23" Background="Transparent"
                        BorderThickness="0" Foreground="{StaticResource PrimaryTextBrush}"/>
                <TextBlock x:Name="PageTitle" Grid.Column="1" Text="Главная"
                           VerticalAlignment="Center" FontSize="19" FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                <Button Grid.Column="2" Content="◷" Click="ToggleLastUpdated_Click"
                        FontSize="20" Background="Transparent" BorderThickness="0"
                        Foreground="{StaticResource SecondaryTextBrush}"/>
                <TextBlock x:Name="ConnectionIndicator" Grid.Column="3" Text="●"
                           Foreground="#FFF05A5A" FontSize="15"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="MenuColumn" Width="0"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="SideMenu" Grid.Column="0" Background="{StaticResource PanelBrush}"
                    Visibility="Collapsed">
                <ScrollViewer>
                    <StackPanel>
                        <TextBlock Text="РАЗДЕЛЫ" Foreground="{StaticResource AccentBrush}"
                                   Margin="12,14,0,8" FontSize="12" FontWeight="SemiBold"/>
                        <Button Content="Сценарии" Style="{StaticResource MenuItemButtonStyle}" Click="Scenarios_Click"/>
                        <Button Content="Голос" Style="{StaticResource MenuItemButtonStyle}" Click="Voice_Click"/>
                        <Button Content="Журнал" Style="{StaticResource MenuItemButtonStyle}" Click="Journal_Click"/>
                        <TextBlock Text="НАСТРОЙКИ" Foreground="{StaticResource AccentBrush}"
                                   Margin="12,22,0,8" FontSize="12" FontWeight="SemiBold"/>
                        <Button Content="MQTT подключение" Style="{StaticResource MenuItemButtonStyle}" Click="MqttSettings_Click"/>
                        <Button Content="UDP устройства" Style="{StaticResource MenuItemButtonStyle}" Click="UdpSettings_Click"/>
                        <Button Content="Настройки приложения" Style="{StaticResource MenuItemButtonStyle}" Click="AppSettings_Click"/>
                        <Button Content="Размер текста" Style="{StaticResource MenuItemButtonStyle}" Click="TextSize_Click"/>
                        <Button Content="Обновление приложения" Style="{StaticResource MenuItemButtonStyle}" Click="Update_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid Grid.Column="1" x:Name="ContentHost" Margin="12,10">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="ContentStack">
                        <TextBlock x:Name="SectionHeading" Text="ESP32-AI-Control"
                                   FontSize="24" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}"/>
                        <TextBlock x:Name="SectionDescription"
                                   Text="Основное приложение ESP32-AI-Control"
                                   FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="StatusText" Text="Ожидание конфигурации устройств."
                                   Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,4"/>
                        <ProgressBar x:Name="UpdateProgressBar" Minimum="0" Maximum="100" Value="0" Height="6" Visibility="Collapsed" Margin="0,8,0,2"/>
                        <TextBlock x:Name="UpdateProgressText" Text="" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"/>
                        <Button x:Name="UpdateDownloadButton" Content="Скачать и установить"
                                Visibility="Collapsed" HorizontalAlignment="Left"
                                Margin="0,12,0,0" Click="DownloadUpdate_Click"/>
                        <StackPanel x:Name="DashboardHost"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0">
            <Grid x:Name="BottomNavigation">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="HomeNav" Grid.Column="0" Style="{StaticResource NavButtonStyle}"
                        Click="Home_Click" Content="⌂&#x0a;Главная"/>
                <Button x:Name="MarfaNav" Grid.Column="1" Style="{StaticResource NavButtonStyle}"
                        Click="Marfa_Click" Content="🎙&#x0a;Марфа"/>
                <Button x:Name="CommandsNav" Grid.Column="2" Style="{StaticResource NavButtonStyle}"
                        Click="Commands_Click" Content="🎤&#x0a;Команды"/>
                <Button x:Name="HistoryNav" Grid.Column="3" Style="{StaticResource NavButtonStyle}"
                        Click="History_Click" Content="▥&#x0a;История"/>
                <Button x:Name="PendingNav" Grid.Column="4" Style="{StaticResource NavButtonStyle}"
                        Click="Pending_Click" Content="◷&#x0a;Отложенные"/>
            </Grid>
        </Border>
    </Grid>


        <!-- In-page credential panel: avoids ContentDialog/ContentDialog2 incompatibility on Windows 10 Mobile. -->
        <Grid x:Name="DevicePortalOverlay" Grid.RowSpan="3" Background="#CC000000" Visibility="Collapsed">
            <Border Background="{StaticResource PanelBrush}" Margin="16" Padding="16" VerticalAlignment="Center">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="560">
                    <StackPanel>
                        <TextBlock Text="Установка обновления" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,16"/>
                        <TextBlock Text="Адрес Lumia (HTTPS)" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="PortalAddressBox" PlaceholderText="Например, 192.168.1.58"/>
                        <TextBlock Text="Логин Device Portal" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,12,0,4"/>
                        <TextBox x:Name="PortalUserBox" PlaceholderText="Имя пользователя Device Portal"/>
                        <TextBlock Text="Пароль Device Portal" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,12,0,4"/>
                        <PasswordBox x:Name="PortalPasswordBox" PlaceholderText="Пароль Device Portal"/>
                        <TextBlock Text="Пароль сохранится в защищённом хранилище Windows и будет использоваться только для подключения к Device Portal по локальной сети." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,12,0,16"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Отмена" Click="PortalCancel_Click" Margin="0,0,8,0"/>
                            <Button Content="Продолжить" Click="PortalContinue_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
</Page>
