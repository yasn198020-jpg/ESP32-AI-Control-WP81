<Page
    x:Class="ESP32AIControl.WP81.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Page.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#FFD0BCFF"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#FF2B2C34"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#FFACADB8"/>
        <SolidColorBrush x:Key="CardBrush" Color="#FF30313A"/>
        <SolidColorBrush x:Key="FieldBrush" Color="#FF25262D"/>
        <SolidColorBrush x:Key="LineBrush" Color="#FF41434D"/>
        <DataTemplate x:Key="WidgetPageHeaderTemplate">
            <Border Background="#FF30313A" CornerRadius="12" Padding="16,10" Margin="0,0,8,0">
                <TextBlock Text="{Binding}" FontSize="14" FontWeight="SemiBold"
                           FontFamily="Segoe UI Symbol"
                           Foreground="#FFEAF1F7" TextWrapping="NoWrap"/>
            </Border>
        </DataTemplate>
        <!-- Unified Android-like settings category tabs for every settings subsection. -->
        <DataTemplate x:Key="SettingsPivotHeaderTemplate">
            <Border Background="#FF30313A" BorderBrush="#FF41434D" BorderThickness="1"
                    CornerRadius="18" Padding="14,8" Margin="0,0,6,0">
                <TextBlock Text="{Binding}" FontSize="13" FontWeight="SemiBold"
                           Foreground="#FFEAF1F7" VerticalAlignment="Center"
                           TextWrapping="NoWrap"/>
            </Border>
        </DataTemplate>
        <Style x:Key="SettingsSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FFD0BCFF"/>
            <Setter Property="Margin" Value="0,18,0,6"/>
        </Style>
        <Style x:Key="SettingsDescriptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#FFACADB8"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFEAF1F7"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF343540"/>
            <Setter Property="Foreground" Value="#FFEAF1F7"/>
            <Setter Property="BorderBrush" Value="#FF4A4B56"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="MinHeight" Value="48"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF25262D"/>
            <Setter Property="Foreground" Value="#FFEAF1F7"/>
            <Setter Property="BorderBrush" Value="#FF4B4C58"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,7,0,7"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#FF2B2B2B"/>
            <Setter Property="Foreground" Value="#FFEAF1F7"/>
            <Setter Property="BorderBrush" Value="#FF555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,7,0,7"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#FF25262D"/>
            <Setter Property="Foreground" Value="#FFEAF1F7"/>
            <Setter Property="BorderBrush" Value="#FF4B4C58"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinHeight" Value="48"/>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Foreground" Value="#FFEAF1F7"/>
            <Setter Property="Background" Value="#FF25262D"/>
            <Setter Property="BorderBrush" Value="#FF4B4C58"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>
        <Style TargetType="TimePicker">
            <Setter Property="Foreground" Value="#FFEAF1F7"/>
            <Setter Property="Background" Value="#FF25262D"/>
            <Setter Property="BorderBrush" Value="#FF4B4C58"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>
        <Style TargetType="Slider"><Setter Property="Foreground" Value="#FFD0BCFF"/></Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#FFEAF1F7"/></Style>
        <Style TargetType="ListView">
            <Setter Property="Background" Value="#FF25262D"/>
            <Setter Property="Foreground" Value="#FFEAF1F7"/>
            <Setter Property="BorderBrush" Value="#FF41434D"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="ListViewItem">
            <Setter Property="Background" Value="#FF30313A"/>
            <Setter Property="Foreground" Value="#FFEAF1F7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
        </Style>
    </Page.Resources>
    <Grid Background="#FF202020">
        <Grid.RowDefinitions>
            <RowDefinition Height="84"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>

        <!-- Android-like top bar: menu, current screen title, info and MQTT cloud status. -->
        <Border Grid.Row="0" Background="#FF202020" BorderBrush="#FF41434D"
                BorderThickness="0,0,0,1" Padding="10,6,10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="38"/>
                    <ColumnDefinition Width="35"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="MenuButton" Grid.Column="0"
                        Click="MenuButton_Click" Background="Transparent"
                        BorderThickness="0" Padding="0"
                        Foreground="#FFEAF1F7" VerticalAlignment="Center"
                        HorizontalAlignment="Center" Width="40" Height="48"
                        AutomationProperties.Name="Открыть меню">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="27">
                        <Border Height="3" Background="#FFEAF1F7" CornerRadius="1" Margin="0,0,0,5"/>
                        <Border Height="3" Background="#FFEAF1F7" CornerRadius="1" Margin="0,0,0,5"/>
                        <Border Height="3" Background="#FFEAF1F7" CornerRadius="1"/>
                    </StackPanel>
                </Button>
                <TextBlock x:Name="PageSubtitle" Grid.Column="1" Text="Главная"
                           FontSize="20" FontWeight="SemiBold" Foreground="#FFEAF1F7"
                           VerticalAlignment="Center" HorizontalAlignment="Left"
                           Margin="4,0,0,0"
                           TextAlignment="Center" TextWrapping="NoWrap"/>
                <Button x:Name="TopInfoButton" Grid.Column="2" Content="ⓘ"
                        Click="TopInfoButton_Click" Background="Transparent"
                        BorderThickness="0" Padding="0" FontSize="22"
                        Foreground="#FFEAF1F7" VerticalAlignment="Stretch"/>
                <TextBlock x:Name="TopConnectionDot" Grid.Column="3" Text="☁"
                           FontSize="25" Foreground="#FFF44336"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid x:Name="MainSections" Grid.Row="1" Background="#FF202020">
<Grid x:Name="HomeSection" Visibility="Visible">
                <Grid Margin="10,0,10,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Page tabs and live widgets are the focus of the Android dashboard. -->
                    <Grid Grid.Row="0">
                        <Pivot x:Name="WidgetPages" Margin="0"
                               HeaderTemplate="{StaticResource WidgetPageHeaderTemplate}"/>
                        <StackPanel x:Name="DashboardEmptyState" VerticalAlignment="Center"
                                    HorizontalAlignment="Center" Margin="24"
                                    IsHitTestVisible="False">
                            <TextBlock Text="Дашборд" FontSize="27" FontWeight="SemiBold"
                                       Foreground="#FFD0BCFF" HorizontalAlignment="Center"/>
                            <TextBlock Text="Здесь появятся виджеты теплиц"
                                       FontSize="16" Foreground="#FFEAF1F7"
                                       TextAlignment="Center" Margin="0,12,0,4"/>
                            <TextBlock Text="Откройте меню ☰ и подключитесь к MQTT в настройках."
                                       FontSize="13" Foreground="#FFB0B0B0"
                                       TextAlignment="Center" TextWrapping="Wrap"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- The bottom-nav microphone reports recognition here without taking dashboard space. -->
                    <TextBlock x:Name="VoiceResultText" Grid.Row="1"
                               Text="Голосовое управление: нажмите «Марфа»"
                               Foreground="#FFB0B0B0" FontSize="12"
                               Margin="8,2,8,6" TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Grid>

            <Grid x:Name="GraphsSection" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12,10,12,12">
                    <StackPanel>
                        <StackPanel Margin="4,4,4,12">
                            
                            <TextBlock Text="История и графики" FontSize="24" FontWeight="SemiBold" Margin="0,2,0,2"/>
                            <TextBlock Text="Изменение показаний датчиков за выбранный период." FontSize="13" Foreground="#FFACADB8"/>
                        </StackPanel>
                        <Border Background="#FF2B2C34" CornerRadius="16" BorderBrush="#FF41434D" BorderThickness="1" Padding="14" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Параметры графика" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <ComboBox x:Name="GraphWidgetBox" Header="Датчик или виджет" Margin="0,2,0,8"/><StackPanel Orientation="Horizontal" Margin="0,2,0,8"><Button Content="Добавить в сравнение" Click="AddCompareWidgetButton_Click" Margin="0,0,6,0"/><Button Content="Очистить список" Click="ClearCompareWidgetsButton_Click"/></StackPanel><ListView x:Name="GraphCompareList" Height="110" SelectionMode="Single" Margin="0,0,0,8"/><StackPanel Orientation="Horizontal" Margin="0,0,0,8"><Button Content="Удалить выбранный" Click="RemoveCompareWidgetButton_Click" Margin="0,0,6,0"/><Button Content="Построить сравнение" Click="BuildCompareGraphButton_Click"/></StackPanel><TextBox x:Name="GraphSetNameBox" Header="Название набора" PlaceholderText="Например: температура"/><StackPanel Orientation="Horizontal" Margin="0,0,0,8"><Button Content="Сохранить набор" Click="SaveGraphSetButton_Click" Margin="0,0,6,0"/><Button Content="Загрузить" Click="LoadGraphSetButton_Click"/></StackPanel><ComboBox x:Name="GraphSavedSetsBox" Header="Сохранённые наборы" Margin="0,0,0,8"/><Button Content="Удалить набор" Click="DeleteGraphSetButton_Click" Margin="0,0,0,8"/><TextBlock Text="Быстрый период:" Foreground="#FFACADB8" Margin="0,0,0,4"/><StackPanel Orientation="Horizontal"><Button Content="24 часа" Click="GraphPresetDayButton_Click" Margin="0,0,4,0"/><Button Content="7 дней" Click="GraphPresetWeekButton_Click" Margin="0,0,4,0"/><Button Content="30 дней" Click="GraphPresetMonthButton_Click"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,4,0,8"><TextBox x:Name="WidgetIntervalBox" Header="Интервал записи (сек)" Width="170" PlaceholderText="Общий интервал"/><Button Content="Сохранить интервал" Click="SaveWidgetIntervalButton_Click" VerticalAlignment="Bottom" Margin="8,0,0,0"/></StackPanel><TextBlock x:Name="WidgetIntervalStatus" Text="Интервал выбранного датчика" Foreground="#FFACADB8" FontSize="12" TextWrapping="Wrap" Margin="2,0,2,8"/>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <DatePicker x:Name="GraphFrom" Header="Начало периода" Margin="0,2,5,2"/>
                                    <DatePicker x:Name="GraphTo" Grid.Column="1" Header="Конец периода" Margin="5,2,0,2"/>
                                </Grid>
                                <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Button Content="Построить график" Click="BuildGraphButton_Click" Background="#FFD0BCFF" BorderBrush="#FFD0BCFF" Foreground="#FF202020" FontWeight="SemiBold" Margin="0,0,5,0"/>
                                    <Button Grid.Column="1" Content="Экспорт Word" Click="ExportGraphButton_Click" Margin="5,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Background="#FF2B2C34" CornerRadius="16" BorderBrush="#FF41434D" BorderThickness="1" Padding="12" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Результат" FontSize="17" FontWeight="SemiBold" Margin="2,0,2,4"/>
                                <TextBlock x:Name="GraphSummary" Text="Выберите датчик и период" Foreground="#FFACADB8" FontSize="12" TextWrapping="Wrap" Margin="2,0,2,8"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,6">
                                    <Button Content="−" Click="ZoomOutGraphButton_Click" MinWidth="44" MinHeight="40"/>
                                    <TextBlock x:Name="GraphZoomLabel" Text="×1,0" VerticalAlignment="Center" Margin="8,0"/>
                                    <Button Content="＋" Click="ZoomInGraphButton_Click" MinWidth="44" MinHeight="40"/>
                                    <Button Content="Сброс" Click="ResetGraphZoomButton_Click" MinHeight="40" Margin="6,0,0,0"/>
                                </StackPanel>
                                <Border Background="#FF202020" CornerRadius="10" Padding="6">
                                    <ScrollViewer x:Name="GraphHorizontalScroll" Height="320"
                                                  HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Disabled">
                                        <Canvas x:Name="GraphCanvas" Height="300" HorizontalAlignment="Left"/>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Запись показаний выполняется с заданным интервалом, а не по каждому MQTT-пакету." FontSize="12" Foreground="#FFACADB8" TextWrapping="Wrap" Margin="4,2,4,8"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid x:Name="TasksSection" Visibility="Collapsed">
                <Grid Margin="12,10,12,12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="4,4,4,12">
                        
                        <TextBlock Text="Планировщик команд ESP32" FontSize="24" FontWeight="SemiBold" Margin="0,2,0,2"/>
                        <TextBlock Text="Команда будет отправлена устройству в указанное время." FontSize="13" Foreground="#FFACADB8"/>
                    </StackPanel>
                    <Border Grid.Row="1" Background="#FF2B2C34" CornerRadius="16" BorderBrush="#FF41434D" BorderThickness="1" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Новая команда" FontSize="17" FontWeight="SemiBold" Margin="2,0,2,4"/>
                            <TextBox x:Name="ScheduleCommandBox" Header="Команда устройству" PlaceholderText="device/widget=value"/>
                            <Grid Margin="0,2,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <DatePicker x:Name="ScheduleDate" Header="Дата" HorizontalAlignment="Stretch" Margin="0,2,5,2"/>
                                <TimePicker x:Name="ScheduleTime" Grid.Column="1" Header="Время" HorizontalAlignment="Stretch" Margin="5,2,0,2"/>
                            </Grid>
                            <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Button Content="Добавить" Click="AddScheduleButton_Click" Background="#FFD0BCFF" BorderBrush="#FFD0BCFF" Foreground="#FF202020" FontWeight="SemiBold" Margin="0,0,5,5"/>
                                <Button Grid.Column="1" Content="Изменить" Click="UpdateScheduleButton_Click" Margin="5,0,0,5"/>
                                <Button Grid.Row="1" Content="Отменить" Click="CancelScheduleButton_Click" Margin="0,5,5,0"/>
                                <Button Grid.Row="1" Grid.Column="1" Content="Обновить список" Click="RefreshScheduleButton_Click" Margin="5,5,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="2" Background="#FF2B2C34" CornerRadius="16" BorderBrush="#FF41434D" BorderThickness="1" Padding="10">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,2,8">
                                <TextBlock Text="Запланировано" FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock Text="  •  выберите запись для изменения" FontSize="11" Foreground="#FFACADB8" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ListView x:Name="ScheduleList" Grid.Row="1" SelectionChanged="ScheduleList_SelectionChanged" Background="#FF25262D" BorderThickness="0"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <Grid x:Name="SettingsSection" Visibility="Collapsed">
                <Grid Margin="12,8,12,8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="4,2,4,8">
                        
                        <TextBlock Text="Настройки" FontSize="24" FontWeight="SemiBold" Margin="0,1,0,1"/>
                        <TextBlock Text="Подключение · хранение · профили · голос · сценарии · журнал" FontSize="12" Foreground="#FFACADB8" TextWrapping="Wrap"/>
                    </StackPanel>
                                            <Pivot x:Name="SettingsPivot" Grid.Row="1" Background="#FF202020" Foreground="#FFEAF1F7"
                           HeaderTemplate="{StaticResource SettingsPivotHeaderTemplate}">
                <PivotItem Header="Подключение">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10,4,10,12">
                            <TextBlock Text="Подключение к MQTT" FontSize="18" FontWeight="SemiBold" Foreground="#FFD0BCFF" Margin="0,12,0,8"/>
                        <TextBox x:Name="HostBox" Header="MQTT сервер или адрес" Text="m4.wqtt.ru" LostFocus="MqttSetting_LostFocus"/>
                        <TextBox x:Name="PortBox" Header="Порт подключения" Text="2815" LostFocus="MqttSetting_LostFocus"/>
                        <TextBox x:Name="PrefixBox" Header="Префикс MQTT" Text="dghjko" LostFocus="MqttSetting_LostFocus"/>
                        <TextBox x:Name="UserNameBox" Header="Имя пользователя" LostFocus="MqttSetting_LostFocus"/>
                        <TextBox x:Name="ClientIdBox" Header="Идентификатор клиента" Text="ESP32-AI-Control-WP81" LostFocus="MqttSetting_LostFocus"/>
                        <PasswordBox x:Name="PasswordBox" Header="Пароль MQTT" LostFocus="MqttSetting_LostFocus"/>
                        <CheckBox x:Name="MqttTlsCheckBox" Content="Использовать защищённое TLS-соединение" Margin="0,8,0,4" Checked="MqttTlsCheckBox_Changed" Unchecked="MqttTlsCheckBox_Changed"/>

                        <TextBlock Text="МАСШТАБ ИНТЕРФЕЙСА" FontSize="17" FontWeight="SemiBold" Foreground="#FFD0BCFF" Margin="0,18,0,6"/>
                        <TextBlock Text="Размер текста и элементов интерфейса" Foreground="#FFACADB8" TextWrapping="Wrap"/>
                        <Slider x:Name="UiFontScaleSlider" Minimum="0.7" Maximum="1.1" Value="0.85" StepFrequency="0.05" />

                        <Border Background="#FF2B2C34" BorderBrush="#FF41434D"
                                BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,10,0,10">
                            <StackPanel>
                                <TextBlock x:Name="ConnectionText" Text="MQTT: отключено"
                                           FontSize="16" Foreground="#FFFFB454" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Content="Подключиться" Click="ConnectButton_Click"
                                            Margin="0,0,4,4" Padding="6,8"/>
                                    <Button Grid.Column="1" Content="Отключиться"
                                            Click="DisconnectButton_Click" Margin="4,0,0,4" Padding="6,8"/>
                                </Grid>
                                <Button Content="Запросить данные (HELLO)" Click="HelloButton_Click"
                                        HorizontalAlignment="Stretch" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        </StackPanel>
                    </ScrollViewer>
                </PivotItem>
                <PivotItem Header="Хранение">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10,4,10,12">
                            <TextBlock Text="Хранение измерений" FontSize="17" FontWeight="SemiBold" Foreground="#FFD0BCFF" Margin="0,14,0,6"/>
                        <TextBox x:Name="MeasurementIntervalBox" Header="Интервал записи, секунд" Text="60"/>
                        <TextBox x:Name="RetentionDaysBox" Header="Период хранения, дней" Text="30"/>
                        <ComboBox x:Name="AutoExportBox" Header="Автоэкспорт Word">
                            <ComboBoxItem Content="Никогда" Tag="Never"/>
                            <ComboBoxItem Content="1 день" Tag="Day"/>
                            <ComboBoxItem Content="Неделя" Tag="Week"/>
                            <ComboBoxItem Content="Месяц" Tag="Month"/>
                        </ComboBox>
                        </StackPanel>
                    </ScrollViewer>
                </PivotItem>
                <PivotItem Header="Сохранённые">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10,4,10,12">
                            <TextBlock Text="Профили подключения" FontSize="17" FontWeight="SemiBold" Foreground="#FFD0BCFF" Margin="0,14,0,6"/>
                            <TextBlock Text="Храните подключения к разным серверам или теплицам. Пароль сохраняется вместе с профилем." TextWrapping="Wrap" Foreground="#FFACADB8" Margin="0,0,0,8"/>
                            <TextBox x:Name="SavedProfileNameBox" Header="Название профиля" PlaceholderText="Например, Основная теплица"/>
                            <ListView x:Name="SavedProfilesList" Height="190" SelectionMode="Single" SelectionChanged="SavedProfilesList_SelectionChanged"/>
                            <Button Content="Сохранить текущие параметры" Click="SaveMqttProfileButton_Click" Margin="0,8,0,4"/>
                            <Button Content="Загрузить выбранный профиль" Click="LoadMqttProfileButton_Click" Margin="0,4"/>
                            <Button Content="Сделать профилем по умолчанию" Click="SetDefaultMqttProfileButton_Click" Margin="0,4"/>
                            <Button Content="Удалить выбранный профиль" Click="DeleteMqttProfileButton_Click" Margin="0,4"/>
                            <TextBlock x:Name="SavedProfilesStatus" Text="" TextWrapping="Wrap" Margin="0,8,0,4"/>
                        </StackPanel>
                    </ScrollViewer>
                </PivotItem>
                <PivotItem Header="Голос">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10,4,10,12">
                            <TextBlock Text="Голосовое управление" FontSize="17" FontWeight="SemiBold" Foreground="#FFD0BCFF" Margin="0,14,0,6"/>
                        <TextBlock Text="СИНТЕЗ РЕЧИ" FontSize="14" FontWeight="SemiBold" Foreground="#FFD0BCFF" Margin="0,14,0,2"/>
                        <TextBlock Text="Голос используется для ответа Марфы после выполнения обученной команды." FontSize="12" Foreground="#FFACADB8" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <ComboBox x:Name="TtsVoiceBox" Header="Системный голос" MinHeight="48"/>
                        <Button Content="Проверить голос" Click="TtsTestButton_Click" Margin="0,4,0,0"/>
                        <TextBlock x:Name="TtsVoiceStatus" Text="Выберите голос и запустите проверку." FontSize="12" Foreground="#FFACADB8" TextWrapping="Wrap" Margin="0,4,0,10"/>
                        <TextBlock Text="КОМАНДЫ ПО УМОЛЧАНИЮ" FontSize="14" FontWeight="SemiBold" Foreground="#FFD0BCFF" Margin="0,14,0,2"/>
                        <TextBox x:Name="VoiceOpenCommandBox" Header="Команда «открой теплицу»" PlaceholderText="device/widget=1"/>
                        <TextBox x:Name="VoiceCloseCommandBox" Header="Команда «закрой теплицу»" PlaceholderText="device/widget=0"/>
                        <TextBlock Text="Сохранённые обученные фразы и их варианты находятся в отдельном разделе «Команды»." FontSize="12" Foreground="#FFACADB8" TextWrapping="Wrap" Margin="0,4,0,8"/>
                        </StackPanel>
                    </ScrollViewer>
                </PivotItem>
                <PivotItem Header="Сценарии">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10,4,10,12">
                            <TextBlock Text="СЦЕНАРИЙ IOTMANAGER" FontSize="17" FontWeight="SemiBold" Foreground="#FFD0BCFF" Margin="0,18,0,6"/>
                        <TextBlock Text="Вставьте сюда блок scenario=> из export.json. Марфа ищет зависимости от реле вверх по условиям сценария."
                                   TextWrapping="Wrap" Foreground="#FFACADB8"/>
                        <TextBox x:Name="ScenarioTextBox"
                                 Header="Сценарий"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Height="220"
                                 />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="Импорт export.json" Click="ImportScenarioButton_Click" Margin="0,0,8,0"/>
                            <Button Content="Проверить план" Click="TestScenarioButton_Click"/>
                        </StackPanel>


                        </StackPanel>
                    </ScrollViewer>
                </PivotItem>
                <PivotItem Header="Автосценарии">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10,4,10,12">
                            <TextBlock Text="ЛОКАЛЬНЫЕ АВТОСЦЕНАРИИ" FontSize="18" FontWeight="SemiBold"
                                       Foreground="#FFD0BCFF" Margin="0,12,0,4"/>
                            <TextBlock Text="Условия проверяются по данным MQTT и WebSocket. Сценарий срабатывает один раз, повторно — после перехода хотя бы одного условия в FALSE."
                                       TextWrapping="Wrap" Foreground="#FFACADB8" Margin="0,0,0,8"/>
                            <TextBox x:Name="LocalScenarioTitleBox" Header="Название сценария"
                                     PlaceholderText="Например, высокая температура"/>
                            <TextBox x:Name="LocalScenarioConditionsBox" Header="Условия (по одному на строку)"
                                     AcceptsReturn="True" TextWrapping="Wrap" Height="100"
                                     PlaceholderText="sensor1 > 25&#10;AND sensor2 = 1&#10;OR sensor3 &lt; 10"/>
                            <TextBlock Text="Формат: widgetId оператор значение. Для следующих строк укажите AND или OR в начале."
                                       TextWrapping="Wrap" FontSize="12" Foreground="#FFACADB8" Margin="0,2,0,6"/>
                            <TextBox x:Name="LocalScenarioActionsBox" Header="Действия MQTT (deviceId/widgetId=value)"
                                     AcceptsReturn="True" TextWrapping="Wrap" Height="72"
                                     PlaceholderText="esp32/relay1=1"/>
                            <TextBox x:Name="LocalScenarioMessageBox" Header="Текст уведомления"
                                     Text="Условие выполнено: {value}"/>
                            <CheckBox x:Name="LocalScenarioEnabledCheckBox" Content="Сценарий включён"
                                      Margin="0,4,0,0"/>
                            <CheckBox x:Name="LocalScenarioNotificationCheckBox" Content="Показывать уведомление"
                                      Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                                <Button x:Name="LocalScenarioSaveButton" Content="Добавить сценарий"
                                        Click="LocalScenarioSaveButton_Click" Margin="0,0,6,0"/>
                                <Button Content="Очистить" Click="LocalScenarioClearButton_Click"/>
                            </StackPanel>
                            <TextBlock Text="СОХРАНЁННЫЕ СЦЕНАРИИ" FontWeight="SemiBold"
                                       Foreground="#FFD0BCFF" Margin="0,6,0,4"/>
                            <ListView x:Name="LocalScenariosList" Height="125"
                                      SelectionMode="Single"
                                      SelectionChanged="LocalScenariosList_SelectionChanged"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="Вкл. / Выкл." Click="LocalScenarioToggleButton_Click"
                                        Margin="0,0,6,0"/>
                                <Button Content="Удалить" Click="LocalScenarioDeleteButton_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="LocalScenariosStatus" Text="" TextWrapping="Wrap"
                                       FontSize="12" Foreground="#FFACADB8" Margin="0,6,0,8"/>
                        </StackPanel>
                    </ScrollViewer>
                </PivotItem>
                <PivotItem Header="Журнал">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10,4,10,12">
                            <TextBlock Text="ЖУРНАЛ СОЕДИНЕНИЯ" FontSize="18" FontWeight="SemiBold"
                                   Foreground="#FFD0BCFF" Margin="0,20,0,4"/>
                        <Border Background="#FF25262D" BorderBrush="#FF41434D"
                                BorderThickness="1" CornerRadius="12" Padding="10" MinHeight="100">
                            <ScrollViewer Height="150" VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="LogText" TextWrapping="Wrap" FontSize="13"/>
                            </ScrollViewer>
                        </Border>
<TextBlock Text="ЭКСПОРТ ДАННЫХ" FontSize="17" FontWeight="SemiBold" Foreground="#FFD0BCFF" Margin="0,18,0,6"/>
                        <Button Content="Экспорт всей истории за сегодня" Click="ExportTodayButton_Click"/>
                        <TextBlock Text="Документы сохраняются в локальной папке приложения. Формат .doc совместим с Word."
                                   Foreground="#FFACADB8" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </PivotItem>
                        </Pivot>
                    <Border Grid.Row="2" Background="#FF2B2C34" BorderBrush="#FF41434D" BorderThickness="1" CornerRadius="14" Padding="10" Margin="0,8,0,0">
                        <StackPanel>
                            <Button Content="Сохранить настройки" Click="SaveSettingsButton_Click"
                                    Background="#FFD0BCFF" BorderBrush="#FFD0BCFF"
                                    Foreground="#FF202020" FontWeight="SemiBold" MinHeight="50"/>
                            <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Button Content="Экспорт копии" Click="ExportSettingsBackupButton_Click" FontSize="12" Padding="6,8" Margin="0,0,4,0"/>
                                <Button Grid.Column="1" Content="Восстановить" Click="ImportSettingsBackupButton_Click" FontSize="12" Padding="6,8" Margin="4,0,0,0"/>
                            </Grid>
                            <TextBlock Text="Резервная копия хранится в общей папке Изображения телефона." TextWrapping="Wrap" FontSize="11" Foreground="#FFACADB8" Margin="2,6,2,2"/>
                            <TextBlock x:Name="SettingsStatus" Text="" TextWrapping="Wrap" FontSize="12" Margin="2,2,2,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
            </Grid>

        <!-- Fixed bottom navigation inspired by the Android app. -->
        <Border Grid.Row="2" Background="#FF24252A"
                BorderBrush="#FF414141" BorderThickness="0,1,0,0">
            <Grid Background="#FF24252A">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="NavHomeButton" Grid.Column="0" Click="NavigateHome_Click"
                    Height="80" Padding="2" BorderThickness="0" FontSize="12">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="▲" FontSize="22" HorizontalAlignment="Center"/>
                    <TextBlock Text="Главная" FontSize="12" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="NavMarfaButton" Grid.Column="1" Click="NavigateMarfa_Click"
                    Height="80" Padding="2" BorderThickness="0" FontSize="11"
                    AutomationProperties.Name="Голосовое управление Марфа">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="🎙" FontSize="22" HorizontalAlignment="Center"/>
                    <TextBlock Text="Марфа" FontSize="12" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="NavCommandsButton" Grid.Column="2" Click="NavigateCommands_Click"
                    Height="68" Padding="2" BorderThickness="0" FontSize="11">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="🎤" FontSize="22" HorizontalAlignment="Center"/>
                    <TextBlock Text="Команды" FontSize="10" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="NavGraphsButton" Grid.Column="3" Click="NavigateGraphs_Click"
                    Height="68" Padding="2" BorderThickness="0" FontSize="11">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="📊" FontSize="22" HorizontalAlignment="Center"/>
                    <TextBlock Text="История" FontSize="10" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="NavTasksButton" Grid.Column="4" Click="NavigateTasks_Click"
                    Height="68" Padding="2" BorderThickness="0" FontSize="11">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="⏱" FontSize="22" HorizontalAlignment="Center"/>
                    <TextBlock Text="Отложенные" FontSize="10" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>

            </Grid>
        </Border>
    </Grid>
</Page>