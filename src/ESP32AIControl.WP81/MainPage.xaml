                </PivotItem>
                <PivotItem Header="Автосценарии">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10,4,10,12">
                            <StackPanel Margin="2,8,2,10">
                                <TextBlock Text="Автоматические сценарии" FontSize="21" FontWeight="SemiBold" Foreground="#FFEAF1F7" Margin="0,0,0,3"/>
                                <TextBlock Text="Создавайте локальные правила: проверяйте значения датчиков и запускайте действия на устройствах. Правила обрабатываются по данным MQTT и WebSocket." FontSize="12" Foreground="#FFACADB8" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Border Background="#FF2B2C34" BorderBrush="#FF41434D" BorderThickness="1" CornerRadius="14" Padding="12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="НОВЫЙ СЦЕНАРИЙ" FontSize="14" FontWeight="SemiBold" Foreground="#FFD0BCFF" Margin="0,0,0,3"/>
                                    <TextBlock Text="Сначала задайте понятное название правила." FontSize="12" Foreground="#FFACADB8" TextWrapping="Wrap" Margin="0,0,0,5"/>
                                    <TextBox x:Name="LocalScenarioTitleBox" Header="Название сценария" PlaceholderText="Например, высокая температура"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#FF2B2C34" BorderBrush="#FF41434D" BorderThickness="1" CornerRadius="14" Padding="12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="1. УСЛОВИЯ СРАБАТЫВАНИЯ" FontSize="14" FontWeight="SemiBold" Foreground="#FFD0BCFF" Margin="0,0,0,3"/>
                                    <TextBlock Text="Выберите датчик, оператор сравнения и пороговое значение." FontSize="12" Foreground="#FFACADB8" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="LocalScenarioConditionWidgetBox" Header="Датчик или виджет" Margin="0,2,0,6"/>
                                    <ComboBox x:Name="LocalScenarioConnectorBox" Header="Связь с предыдущим условием" SelectedIndex="0" Margin="0,0,0,6">
                                        <ComboBoxItem Content="И (AND)" Tag="AND"/>
                                        <ComboBoxItem Content="ИЛИ (OR)" Tag="OR"/>
                                    </ComboBox>
                                    <ComboBox x:Name="LocalScenarioOperatorBox" Header="Оператор сравнения" SelectedIndex="0" Margin="0,0,0,6">
                                        <ComboBoxItem Content="Больше >" Tag=">"/>
                                        <ComboBoxItem Content="Не меньше ≥" Tag=">="/>
                                        <ComboBoxItem Content="Меньше &lt;" Tag="&lt;"/>
                                        <ComboBoxItem Content="Не больше ≤" Tag="&lt;="/>
                                        <ComboBoxItem Content="Равно =" Tag="="/>
                                        <ComboBoxItem Content="Не равно ≠" Tag="!="/>
                                    </ComboBox>
                                    <TextBox x:Name="LocalScenarioThresholdBox" Header="Пороговое значение" PlaceholderText="Например, 25" Margin="0,0,0,8"/>
                                    <Button Content="＋ Добавить условие" Click="LocalScenarioAddConditionButton_Click" HorizontalAlignment="Stretch"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#FF2B2C34" BorderBrush="#FF41434D" BorderThickness="1" CornerRadius="14" Padding="12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="СПИСОК УСЛОВИЙ" FontSize="14" FontWeight="SemiBold" Foreground="#FFD0BCFF" Margin="0,0,0,3"/>
                                    <TextBlock Text="Проверьте последовательность условий. Для следующих строк используйте AND или OR в начале." FontSize="12" Foreground="#FFACADB8" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                    <TextBox x:Name="LocalScenarioConditionsBox" Header="Условия правила" AcceptsReturn="True" TextWrapping="Wrap" Height="110" PlaceholderText="sensor1 > 25&#10;AND sensor2 = 1&#10;OR sensor3 &lt; 10"/>
                                    <TextBlock Text="Формат строки: widgetId оператор значение." FontSize="11" Foreground="#FFACADB8" TextWrapping="Wrap" Margin="2,6,2,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#FF2B2C34" BorderBrush="#FF41434D" BorderThickness="1" CornerRadius="14" Padding="12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="2. ДЕЙСТВИЯ ПРИ СРАБАТЫВАНИИ" FontSize="14" FontWeight="SemiBold" Foreground="#FFD0BCFF" Margin="0,0,0,3"/>
                                    <TextBlock Text="Укажите исполнительный виджет и значение, которое будет отправлено." FontSize="12" Foreground="#FFACADB8" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="LocalScenarioActionWidgetBox" Header="Устройство и исполнительный виджет" Margin="0,2,0,6"/>
                                    <TextBox x:Name="LocalScenarioActionValueBox" Header="Отправляемое значение" Text="1" PlaceholderText="Например, 1 или 0" Margin="0,0,0,8"/>
                                    <Button Content="＋ Добавить действие" Click="LocalScenarioAddActionButton_Click" HorizontalAlignment="Stretch"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#FF2B2C34" BorderBrush="#FF41434D" BorderThickness="1" CornerRadius="14" Padding="12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="СПИСОК ДЕЙСТВИЙ" FontSize="14" FontWeight="SemiBold" Foreground="#FFD0BCFF" Margin="0,0,0,3"/>
                                    <TextBlock Text="Проверьте команды, которые будут отправлены при выполнении правила." FontSize="12" Foreground="#FFACADB8" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                    <TextBox x:Name="LocalScenarioActionsBox" Header="Действия правила" AcceptsReturn="True" TextWrapping="Wrap" Height="90" PlaceholderText="esp32/relay1=1"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#FF2B2C34" BorderBrush="#FF41434D" BorderThickness="1" CornerRadius="14" Padding="12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="3. УВЕДОМЛЕНИЯ И АКТИВАЦИЯ" FontSize="14" FontWeight="SemiBold" Foreground="#FFD0BCFF" Margin="0,0,0,3"/>
                                    <TextBlock Text="Настройте сообщение и выберите, должен ли сценарий быть активен сразу после сохранения." FontSize="12" Foreground="#FFACADB8" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                    <TextBox x:Name="LocalScenarioMessageBox" Header="Текст уведомления" Text="Условие выполнено: {value}"/>
                                    <CheckBox x:Name="LocalScenarioEnabledCheckBox" Content="Сценарий включён" Margin="0,8,0,2"/>
                                    <CheckBox x:Name="LocalScenarioNotificationCheckBox" Content="Показывать уведомление" Margin="0,2,0,2"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#FF2B2C34" BorderBrush="#FF41434D" BorderThickness="1" CornerRadius="14" Padding="12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="СОХРАНЕНИЕ СЦЕНАРИЯ" FontSize="14" FontWeight="SemiBold" Foreground="#FFD0BCFF" Margin="0,0,0,6"/>
                                    <Button x:Name="LocalScenarioSaveButton" Content="Добавить сценарий" Click="LocalScenarioSaveButton_Click" HorizontalAlignment="Stretch" Background="#FFD0BCFF" BorderBrush="#FFD0BCFF" Foreground="#FF202020" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <Button Content="Очистить форму" Click="LocalScenarioClearButton_Click" HorizontalAlignment="Stretch"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#FF2B2C34" BorderBrush="#FF41434D" BorderThickness="1" CornerRadius="14" Padding="12" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="СОХРАНЁННЫЕ СЦЕНАРИИ" FontSize="14" FontWeight="SemiBold" Foreground="#FFD0BCFF" Margin="0,0,0,3"/>
                                    <TextBlock Text="Выберите правило, чтобы включить, выключить или удалить его. Сценарий срабатывает один раз и может сработать снова после того, как хотя бы одно условие станет FALSE." FontSize="12" Foreground="#FFACADB8" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <ListView x:Name="LocalScenariosList" Height="220" SelectionMode="Single" SelectionChanged="LocalScenariosList_SelectionChanged"/>
                                    <Button Content="Включить / выключить выбранный" Click="LocalScenarioToggleButton_Click" HorizontalAlignment="Stretch" Margin="0,8,0,6"/>
                                    <Button Content="Удалить выбранный сценарий" Click="LocalScenarioDeleteButton_Click" HorizontalAlignment="Stretch"/>
                                    <TextBlock x:Name="LocalScenariosStatus" Text="" TextWrapping="Wrap" FontSize="12" Foreground="#FFACADB8" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </PivotItem>
                <PivotItem Header="Журнал">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10,4,10,12">
                            <StackPanel Margin="2,8,2,10">
                                <TextBlock Text="Журнал и экспорт" FontSize="21" FontWeight="SemiBold"
                                           Foreground="#FFEAF1F7" Margin="0,0,0,3"/>
                                <TextBlock Text="Здесь отображаются события сетевого обмена, подключения и ошибки. Новые записи появляются сверху."
                                           FontSize="12" Foreground="#FFACADB8" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Border Background="#FF2B2C34" BorderBrush="#FF41434D" BorderThickness="1"
                                    CornerRadius="14" Padding="12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="ЖУРНАЛ СОЕДИНЕНИЯ" FontSize="14" FontWeight="SemiBold"
                                               Foreground="#FFD0BCFF" Margin="0,0,0,4"/>
                                    <TextBlock Text="События MQTT, UDP, WebSocket и сетевые ошибки. Выберите категорию, чтобы быстрее найти нужную запись."
                                               FontSize="12" Foreground="#FFACADB8" TextWrapping="Wrap"
                                               Margin="0,0,0,8"/>
                                    <ComboBox x:Name="LogModeBox" Header="Источник записей"
                                              SelectedIndex="0"
                                              SelectionChanged="LogModeBox_SelectionChanged">
                                        <ComboBoxItem Content="Текущая сессия" Tag="SESSION"/>
                                        <ComboBoxItem Content="Сохранённый сетевой журнал" Tag="SAVED"/>
                                    </ComboBox>
                                    <TextBlock Text="Windows Phone 8.1 не ведёт отдельные Android-журналы фоновой службы. Здесь доступны события текущей сессии и сохранённая сетевая диагностика."
                                               FontSize="11" Foreground="#FFACADB8"
                                               TextWrapping="Wrap" Margin="2,0,2,6"/>
                                    <ComboBox x:Name="LogFilterBox" Header="Фильтр событий"
                                              SelectedIndex="0"
                                              SelectionChanged="LogFilterBox_SelectionChanged">
                                        <ComboBoxItem Content="Все события" Tag="ALL"/>
                                        <ComboBoxItem Content="MQTT" Tag="MQTT"/>
                                        <ComboBoxItem Content="UDP / обнаружение" Tag="UDP"/>
                                        <ComboBoxItem Content="WebSocket" Tag="WS"/>
                                        <ComboBoxItem Content="Сценарии" Tag="SCENARIO"/>
                                        <ComboBoxItem Content="Действия" Tag="ACTION"/>
                                        <ComboBoxItem Content="Проверка" Tag="VERIFY"/>
                                        <ComboBoxItem Content="Ошибки" Tag="ERROR"/>
                                    </ComboBox>
                                    <Button Content="Копировать отображаемые записи"
                                            Click="CopyLogButton_Click"
                                            HorizontalAlignment="Stretch" Margin="0,2,0,4"/>
                                    <Button Content="Очистить журнал"
                                            Click="ClearLogButton_Click"
                                            HorizontalAlignment="Stretch" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="LogActionStatus" Text=""
                                               FontSize="11" Foreground="#FFACADB8"
                                               TextWrapping="Wrap" Margin="2,0,2,8"/>
                                    <Border Background="#FF1E1F25" BorderBrush="#FF41434D"
                                            BorderThickness="1" CornerRadius="10" Padding="8">
                                        <ScrollViewer Height="230" VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <TextBlock x:Name="LogText" TextWrapping="Wrap"
                                                       FontSize="13" Foreground="#FFE1E3E8"
                                                       IsTextSelectionEnabled="True"/>
                                        </ScrollViewer>
                                    </Border>
                                    <TextBlock Text="Журнал хранит ограниченное количество последних событий; старые записи удаляются автоматически."
                                               FontSize="11" Foreground="#FFACADB8"
                                               TextWrapping="Wrap" Margin="2,8,2,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#FF2B2C34" BorderBrush="#FF41434D" BorderThickness="1"
                                    CornerRadius="14" Padding="12" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="ЭКСПОРТ ИСТОРИИ" FontSize="14" FontWeight="SemiBold"
                                               Foreground="#FFD0BCFF" Margin="0,0,0,4"/>
                                    <TextBlock Text="Создайте документ с измерениями за текущий день. Файл сохраняется в локальной папке приложения и открывается в Microsoft Word или совместимом редакторе."
                                               FontSize="12" Foreground="#FFACADB8" TextWrapping="Wrap"
                                               Margin="0,0,0,8"/>
                                    <Button Content="Экспортировать историю за сегодня"
                                            Click="ExportTodayButton_Click"
                                            HorizontalAlignment="Stretch"
                                            Background="#FFD0BCFF" BorderBrush="#FFD0BCFF"
                                            Foreground="#FF202020" FontWeight="SemiBold"/>
                                    <TextBlock Text="Результат экспорта и возможные ошибки отображаются в статусе настроек."
                                               FontSize="11" Foreground="#FFACADB8"
                                               TextWrapping="Wrap" Margin="2,8,2,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </PivotItem>
                        </Pivot>
                    <Border Grid.Row="2" Background="#FF2B2C34" BorderBrush="#FF41434D" BorderThickness="1" CornerRadius="14" Padding="10" Margin="0,8,0,0">
                        <StackPanel>
                            <Button Content="Сохранить настройки" Click="SaveSettingsButton_Click"
                                    Background="#FFD0BCFF" BorderBrush="#FFD0BCFF"
                                    Foreground="#FF202020" FontWeight="SemiBold" MinHeight="50"/>
                            <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Button Content="Экспорт копии" Click="ExportSettingsBackupButton_Click" FontSize="12" Padding="6,8" Margin="0,0,4,0"/>
                                <Button Grid.Column="1" Content="Восстановить" Click="ImportSettingsBackupButton_Click" FontSize="12" Padding="6,8" Margin="4,0,0,0"/>
                            </Grid>
                            <TextBlock Text="Резервная копия хранится в общей папке Изображения телефона." TextWrapping="Wrap" FontSize="11" Foreground="#FFACADB8" Margin="2,6,2,2"/>
                            <TextBlock x:Name="SettingsStatus" Text="" TextWrapping="Wrap" FontSize="12" Margin="2,2,2,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
            </Grid>

        <!-- Fixed bottom navigation inspired by the Android app. -->
        <Border Grid.Row="2" Background="#FF24252A"
                BorderBrush="#FF414141" BorderThickness="0,1,0,0">
            <Grid Background="#FF24252A">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="NavHomeButton" Grid.Column="0" Click="NavigateHome_Click"
                    Height="80" Padding="2" BorderThickness="0"
                    Background="Transparent" Foreground="#FFACADB8">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border x:Name="NavHomeButtonIndicator" Width="64" Height="30"
                            CornerRadius="16" Background="Transparent"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="▲" FontSize="22" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Foreground="#FFACADB8"/>
                    </Border>
                    <TextBlock Text="Главная" FontSize="12" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Foreground="#FFACADB8"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Button>
            <Button x:Name="NavMarfaButton" Grid.Column="1" Click="NavigateMarfa_Click"
                    Height="80" Padding="2" BorderThickness="0"
                    Background="Transparent" Foreground="#FFACADB8"
                    AutomationProperties.Name="Голосовое управление Марфа">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border x:Name="NavMarfaButtonIndicator" Width="64" Height="30"
                            CornerRadius="16" Background="Transparent"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="🎙" FontSize="22" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Foreground="#FFACADB8"/>
                    </Border>
                    <TextBlock Text="Марфа" FontSize="12" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Foreground="#FFACADB8"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Button>
            <Button x:Name="NavCommandsButton" Grid.Column="2" Click="NavigateCommands_Click"
                    Height="80" Padding="2" BorderThickness="0"
                    Background="Transparent" Foreground="#FFACADB8">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border x:Name="NavCommandsButtonIndicator" Width="64" Height="30"
                            CornerRadius="16" Background="Transparent"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="🎤" FontSize="22" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Foreground="#FFACADB8"/>
                    </Border>
                    <TextBlock Text="Команды" FontSize="11" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Foreground="#FFACADB8"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Button>
            <Button x:Name="NavGraphsButton" Grid.Column="3" Click="NavigateGraphs_Click"
                    Height="80" Padding="2" BorderThickness="0"
                    Background="Transparent" Foreground="#FFACADB8">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border x:Name="NavGraphsButtonIndicator" Width="64" Height="30"
                            CornerRadius="16" Background="Transparent"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="📊" FontSize="22" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Foreground="#FFACADB8"/>
                    </Border>
                    <TextBlock Text="История" FontSize="11" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Foreground="#FFACADB8"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Button>
            <Button x:Name="NavTasksButton" Grid.Column="4" Click="NavigateTasks_Click"
                    Height="80" Padding="2" BorderThickness="0"
                    Background="Transparent" Foreground="#FFACADB8">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border x:Name="NavTasksButtonIndicator" Width="64" Height="30"
                            CornerRadius="16" Background="Transparent"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="⏱" FontSize="22" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Foreground="#FFACADB8"/>
                    </Border>
                    <TextBlock Text="Отложенные" FontSize="10" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Foreground="#FFACADB8"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Button>

            </Grid>
        </Border>
    </Grid>
</Page>