<Page
    x:Class="ESP32AIControl.WP81.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Page.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF8065E8"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#FF2A2A2A"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#FFB0B0B0"/>
        <DataTemplate x:Key="WidgetPageHeaderTemplate">
            <Border Background="#FF303030" CornerRadius="12" Padding="16,10" Margin="0,0,8,0">
                <TextBlock Text="{Binding}" FontSize="14" FontWeight="SemiBold"
                           FontFamily="Segoe UI Symbol"
                           Foreground="#FFEAF1F7" TextWrapping="NoWrap"/>
            </Border>
        </DataTemplate>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFEAF1F7"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF303030"/>
            <Setter Property="Foreground" Value="#FFEAF1F7"/>
            <Setter Property="BorderBrush" Value="#FF484848"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="MinHeight" Value="44"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF2B2B2B"/>
            <Setter Property="Foreground" Value="#FFEAF1F7"/>
            <Setter Property="BorderBrush" Value="#FF555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,7,0,7"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#FF2B2B2B"/>
            <Setter Property="Foreground" Value="#FFEAF1F7"/>
            <Setter Property="BorderBrush" Value="#FF555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,7,0,7"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#FF2B2B2B"/>
            <Setter Property="Foreground" Value="#FFEAF1F7"/>
            <Setter Property="BorderBrush" Value="#FF555555"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="ListView">
            <Setter Property="Background" Value="#FF2B2B2B"/>
            <Setter Property="Foreground" Value="#FFEAF1F7"/>
            <Setter Property="BorderBrush" Value="#FF414141"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Page.Resources>
    <Grid Background="#FF202020">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="68"/>
        </Grid.RowDefinitions>

        <!-- Android-like top bar: menu, current screen title, info and MQTT cloud status. -->
        <Border Grid.Row="0" Background="#FF202020" BorderBrush="#FF414141"
                BorderThickness="0,0,0,1" Padding="10,6,10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="38"/>
                    <ColumnDefinition Width="35"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="MenuButton" Grid.Column="0"
                        Click="MenuButton_Click" Background="Transparent"
                        BorderThickness="0" Padding="0"
                        Foreground="#FFEAF1F7" VerticalAlignment="Center"
                        HorizontalAlignment="Center" Width="40" Height="48"
                        AutomationProperties.Name="Открыть меню">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="27">
                        <Border Height="3" Background="#FFEAF1F7" CornerRadius="1" Margin="0,0,0,5"/>
                        <Border Height="3" Background="#FFEAF1F7" CornerRadius="1" Margin="0,0,0,5"/>
                        <Border Height="3" Background="#FFEAF1F7" CornerRadius="1"/>
                    </StackPanel>
                </Button>
                <TextBlock x:Name="PageSubtitle" Grid.Column="1" Text="Главная"
                           FontSize="20" FontWeight="SemiBold" Foreground="#FFEAF1F7"
                           VerticalAlignment="Center" HorizontalAlignment="Left"
                           Margin="4,0,0,0"
                           TextAlignment="Center" TextWrapping="NoWrap"/>
                <Button x:Name="TopInfoButton" Grid.Column="2" Content="ⓘ"
                        Click="TopInfoButton_Click" Background="Transparent"
                        BorderThickness="0" Padding="0" FontSize="22"
                        Foreground="#FFEAF1F7" VerticalAlignment="Stretch"/>
                <TextBlock x:Name="TopConnectionDot" Grid.Column="3" Text="☁"
                           FontSize="25" Foreground="#FFF44336"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid x:Name="MainSections" Grid.Row="1" Background="#FF202020">
<Grid x:Name="HomeSection" Visibility="Visible">
                <Grid Margin="10,0,10,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Page tabs and live widgets are the focus of the Android dashboard. -->
                    <Grid Grid.Row="0">
                        <Pivot x:Name="WidgetPages" Margin="0"
                               HeaderTemplate="{StaticResource WidgetPageHeaderTemplate}"/>
                        <StackPanel x:Name="DashboardEmptyState" VerticalAlignment="Center"
                                    HorizontalAlignment="Center" Margin="24"
                                    IsHitTestVisible="False">
                            <TextBlock Text="Дашборд" FontSize="27" FontWeight="SemiBold"
                                       Foreground="#FF8065E8" HorizontalAlignment="Center"/>
                            <TextBlock Text="Здесь появятся виджеты теплиц"
                                       FontSize="16" Foreground="#FFEAF1F7"
                                       TextAlignment="Center" Margin="0,12,0,4"/>
                            <TextBlock Text="Откройте меню ☰ и подключитесь к MQTT в настройках."
                                       FontSize="13" Foreground="#FFB0B0B0"
                                       TextAlignment="Center" TextWrapping="Wrap"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- The bottom-nav microphone reports recognition here without taking dashboard space. -->
                    <TextBlock x:Name="VoiceResultText" Grid.Row="1"
                               Text="Голосовое управление: нажмите «Марфа»"
                               Foreground="#FFB0B0B0" FontSize="12"
                               Margin="8,2,8,6" TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Grid>

            <Grid x:Name="GraphsSection" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="16,14,16,14">
                    <StackPanel>
                        <TextBlock Text="История и графики" FontSize="22" FontWeight="SemiBold" Foreground="#FFEAF1F7"/>
                        <TextBlock Text="Запись производится с заданным интервалом, а не по каждому MQTT-пакету."
                                   TextWrapping="Wrap" Opacity="0.7" Margin="0,4,0,10"/>
                        <ComboBox x:Name="GraphWidgetBox" Header="Датчик / виджет" Margin="0,4"/>
                        <StackPanel>
                            <DatePicker x:Name="GraphFrom" Header="Начало периода" Margin="0,4"/>
                            <DatePicker x:Name="GraphTo" Header="Конец периода" Margin="0,4"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,10">
                            <Button Content="Построить" Click="BuildGraphButton_Click" Margin="0,0,8,0"/>
                            <Button Content="Экспорт Word" Click="ExportGraphButton_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="GraphSummary" Text="—" Margin="0,0,0,8"/>
                        <Border BorderThickness="1" Padding="4">
                            <Canvas x:Name="GraphCanvas" Height="300" HorizontalAlignment="Stretch"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid x:Name="TasksSection" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="16,14,16,16">
                    <StackPanel>
                        <TextBlock Text="Отложенные команды" FontSize="22" FontWeight="SemiBold" Foreground="#FFEAF1F7"/>
                        <TextBlock Text="Формат команды: устройство/элемент=значение" Opacity="0.7" Margin="0,4,0,8"/>
                        <TextBox x:Name="ScheduleCommandBox" Header="Команда устройству"/>
                        <Grid Margin="0,4,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <DatePicker x:Name="ScheduleDate" Header="Дата" HorizontalAlignment="Stretch" Margin="0,4,5,4"/>
                            <TimePicker x:Name="ScheduleTime" Grid.Column="1" Header="Время" HorizontalAlignment="Stretch" Margin="5,4,0,4"/>
                        </Grid>
                        <Grid Margin="0,4,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Button Content="ДОБАВИТЬ" Click="AddScheduleButton_Click" Margin="0,0,4,4"/>
                            <Button Grid.Column="1" Content="ИЗМЕНИТЬ" Click="UpdateScheduleButton_Click" Margin="4,0,0,4"/>
                            <Button Grid.Row="1" Content="ОТМЕНИТЬ" Click="CancelScheduleButton_Click" Margin="0,4,4,0"/>
                            <Button Grid.Row="1" Grid.Column="1" Content="ОБНОВИТЬ" Click="RefreshScheduleButton_Click" Margin="4,4,0,0"/>
                        </Grid>
                        <ListView x:Name="ScheduleList" Height="280" SelectionChanged="ScheduleList_SelectionChanged"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid x:Name="SettingsSection" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12,10,12,10">
                    <StackPanel>
                        <TextBlock Text="Настройки" FontSize="24" FontWeight="SemiBold" Foreground="#FFF4F4F4" Margin="4,0,0,2"/>
                        <TextBlock Text="Подключение, хранение данных, профили и голосовое управление"
                                   FontSize="13" Foreground="#FFB0B0B0" TextWrapping="Wrap"
                                   Margin="4,0,4,12"/>
                        <Pivot x:Name="SettingsPivot" Height="600" Background="#FF202020" Foreground="#FFEAF1F7">
                <PivotItem Header="Подключение">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8,0,8,8">
                            <TextBlock Text="ПОДКЛЮЧЕНИЕ" FontSize="22" FontWeight="Light" Foreground="#FF8065E8"/>
                        <TextBox x:Name="HostBox" Header="MQTT сервер или адрес" Text="m4.wqtt.ru" LostFocus="MqttSetting_LostFocus"/>
                        <TextBox x:Name="PortBox" Header="Порт подключения" Text="2815" LostFocus="MqttSetting_LostFocus"/>
                        <TextBox x:Name="PrefixBox" Header="Префикс MQTT" Text="dghjko" LostFocus="MqttSetting_LostFocus"/>
                        <TextBox x:Name="UserNameBox" Header="Имя пользователя" LostFocus="MqttSetting_LostFocus"/>
                        <TextBox x:Name="ClientIdBox" Header="Идентификатор клиента" Text="ESP32-AI-Control-WP81" LostFocus="MqttSetting_LostFocus"/>
                        <PasswordBox x:Name="PasswordBox" Header="Пароль MQTT" LostFocus="MqttSetting_LostFocus"/>
                        <CheckBox x:Name="MqttTlsCheckBox" Content="Использовать защищённое TLS-соединение" Margin="0,8,0,4" Checked="MqttTlsCheckBox_Changed" Unchecked="MqttTlsCheckBox_Changed"/>

                        <TextBlock Text="МАСШТАБ ИНТЕРФЕЙСА" FontSize="18" FontWeight="SemiBold" Foreground="#FF8065E8" Margin="0,20,0,4"/>
                        <TextBlock Text="Размер текста и элементов интерфейса" Opacity="0.7" TextWrapping="Wrap"/>
                        <Slider x:Name="UiFontScaleSlider" Minimum="0.7" Maximum="1.1" Value="0.85" StepFrequency="0.05" />

                        <Border Background="#FF2B2B2B" BorderBrush="#FF414141"
                                BorderThickness="1" Padding="10" Margin="0,8,0,8">
                            <StackPanel>
                                <TextBlock x:Name="ConnectionText" Text="MQTT: отключено"
                                           FontSize="16" Foreground="#FFFFB454" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Content="Подключиться" Click="ConnectButton_Click"
                                            Margin="0,0,4,4" Padding="6,8"/>
                                    <Button Grid.Column="1" Content="Отключиться"
                                            Click="DisconnectButton_Click" Margin="4,0,0,4" Padding="6,8"/>
                                </Grid>
                                <Button Content="Запросить данные (HELLO)" Click="HelloButton_Click"
                                        HorizontalAlignment="Stretch" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        </StackPanel>
                    </ScrollViewer>
                </PivotItem>
                <PivotItem Header="Хранение">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8,0,8,8">
                            <TextBlock Text="ГРАФИКИ И ХРАНЕНИЕ" FontSize="18" FontWeight="SemiBold" Foreground="#FF8065E8" Margin="0,20,0,4"/>
                        <TextBox x:Name="MeasurementIntervalBox" Header="Интервал записи, секунд" Text="60"/>
                        <TextBox x:Name="RetentionDaysBox" Header="Период хранения, дней" Text="30"/>
                        <ComboBox x:Name="AutoExportBox" Header="Автоэкспорт Word">
                            <ComboBoxItem Content="Никогда" Tag="Never"/>
                            <ComboBoxItem Content="1 день" Tag="Day"/>
                            <ComboBoxItem Content="Неделя" Tag="Week"/>
                            <ComboBoxItem Content="Месяц" Tag="Month"/>
                        </ComboBox>
                        </StackPanel>
                    </ScrollViewer>
                </PivotItem>
                <PivotItem Header="Сохранённые">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8,0,8,8">
                            <TextBlock Text="СОХРАНЁННЫЕ MQTT-ПРОФИЛИ" FontSize="18" FontWeight="SemiBold" Foreground="#FF8065E8" Margin="0,20,0,4"/>
                            <TextBlock Text="Храните подключения к разным серверам или теплицам. Пароль сохраняется вместе с профилем." TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,8"/>
                            <TextBox x:Name="SavedProfileNameBox" Header="Название профиля" PlaceholderText="Например, Основная теплица"/>
                            <ListView x:Name="SavedProfilesList" Height="190" SelectionMode="Single" SelectionChanged="SavedProfilesList_SelectionChanged"/>
                            <Button Content="Сохранить текущие параметры" Click="SaveMqttProfileButton_Click" Margin="0,8,0,4"/>
                            <Button Content="Загрузить выбранный профиль" Click="LoadMqttProfileButton_Click" Margin="0,4"/>
                            <Button Content="Сделать профилем по умолчанию" Click="SetDefaultMqttProfileButton_Click" Margin="0,4"/>
                            <Button Content="Удалить выбранный профиль" Click="DeleteMqttProfileButton_Click" Margin="0,4"/>
                            <TextBlock x:Name="SavedProfilesStatus" Text="" TextWrapping="Wrap" Margin="0,8,0,4"/>
                        </StackPanel>
                    </ScrollViewer>
                </PivotItem>
                <PivotItem Header="Голос">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8,0,8,8">
                            <TextBlock Text="ГОЛОСОВОЕ УПРАВЛЕНИЕ" FontSize="18" FontWeight="SemiBold" Foreground="#FF8065E8" Margin="0,20,0,4"/>
                        <TextBox x:Name="VoiceOpenCommandBox" Header="Команда «открой теплицу»" PlaceholderText="device/widget=1"/>
                        <TextBox x:Name="VoiceCloseCommandBox" Header="Команда «закрой теплицу»" PlaceholderText="device/widget=0"/>
                        </StackPanel>
                    </ScrollViewer>
                </PivotItem>
                <PivotItem Header="Сценарии">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8,0,8,8">
                            <TextBlock Text="СЦЕНАРИЙ IOTMANAGER" FontSize="18" FontWeight="SemiBold" Foreground="#FF8065E8" Margin="0,20,0,4"/>
                        <TextBlock Text="Вставьте сюда блок scenario=> из export.json. Марфа ищет зависимости от реле вверх по условиям сценария."
                                   TextWrapping="Wrap" Opacity="0.7"/>
                        <TextBox x:Name="ScenarioTextBox"
                                 Header="Сценарий"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Height="220"
                                 />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="Импорт export.json" Click="ImportScenarioButton_Click" Margin="0,0,8,0"/>
                            <Button Content="Проверить план" Click="TestScenarioButton_Click"/>
                        </StackPanel>


                        </StackPanel>
                    </ScrollViewer>
                </PivotItem>
                <PivotItem Header="Автосценарии">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8,0,8,8">
                            <TextBlock Text="ЛОКАЛЬНЫЕ АВТОСЦЕНАРИИ" FontSize="18" FontWeight="SemiBold"
                                       Foreground="#FF8065E8" Margin="0,12,0,4"/>
                            <TextBlock Text="Условия проверяются по данным MQTT и WebSocket. Сценарий срабатывает один раз, повторно — после перехода хотя бы одного условия в FALSE."
                                       TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,8"/>
                            <TextBox x:Name="LocalScenarioTitleBox" Header="Название сценария"
                                     PlaceholderText="Например, высокая температура"/>
                            <TextBox x:Name="LocalScenarioConditionsBox" Header="Условия (по одному на строку)"
                                     AcceptsReturn="True" TextWrapping="Wrap" Height="100"
                                     PlaceholderText="sensor1 > 25&#10;AND sensor2 = 1&#10;OR sensor3 &lt; 10"/>
                            <TextBlock Text="Формат: widgetId оператор значение. Для следующих строк укажите AND или OR в начале."
                                       TextWrapping="Wrap" FontSize="12" Opacity="0.7" Margin="0,2,0,6"/>
                            <TextBox x:Name="LocalScenarioActionsBox" Header="Действия MQTT (deviceId/widgetId=value)"
                                     AcceptsReturn="True" TextWrapping="Wrap" Height="72"
                                     PlaceholderText="esp32/relay1=1"/>
                            <TextBox x:Name="LocalScenarioMessageBox" Header="Текст уведомления"
                                     Text="Условие выполнено: {value}"/>
                            <CheckBox x:Name="LocalScenarioEnabledCheckBox" Content="Сценарий включён"
                                      Margin="0,4,0,0"/>
                            <CheckBox x:Name="LocalScenarioNotificationCheckBox" Content="Показывать уведомление"
                                      Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                                <Button x:Name="LocalScenarioSaveButton" Content="Добавить сценарий"
                                        Click="LocalScenarioSaveButton_Click" Margin="0,0,6,0"/>
                                <Button Content="Очистить" Click="LocalScenarioClearButton_Click"/>
                            </StackPanel>
                            <TextBlock Text="СОХРАНЁННЫЕ СЦЕНАРИИ" FontWeight="SemiBold"
                                       Foreground="#FF8065E8" Margin="0,6,0,4"/>
                            <ListView x:Name="LocalScenariosList" Height="125"
                                      SelectionMode="Single"
                                      SelectionChanged="LocalScenariosList_SelectionChanged"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="Вкл. / Выкл." Click="LocalScenarioToggleButton_Click"
                                        Margin="0,0,6,0"/>
                                <Button Content="Удалить" Click="LocalScenarioDeleteButton_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="LocalScenariosStatus" Text="" TextWrapping="Wrap"
                                       FontSize="12" Opacity="0.75" Margin="0,6,0,8"/>
                        </StackPanel>
                    </ScrollViewer>
                </PivotItem>
                <PivotItem Header="Журнал">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8,0,8,8">
                            <TextBlock Text="ЖУРНАЛ СОЕДИНЕНИЯ" FontSize="18" FontWeight="SemiBold"
                                   Foreground="#FF8065E8" Margin="0,20,0,4"/>
                        <Border Background="#FF17191F" BorderBrush="#FF414141"
                                BorderThickness="1" Padding="8" MinHeight="100">
                            <ScrollViewer Height="150" VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="LogText" TextWrapping="Wrap" FontSize="13"/>
                            </ScrollViewer>
                        </Border>
<TextBlock Text="ЭКСПОРТ ДАННЫХ" FontSize="18" FontWeight="SemiBold" Foreground="#FF8065E8" Margin="0,20,0,4"/>
                        <Button Content="Экспорт всей истории за сегодня" Click="ExportTodayButton_Click"/>
                        <TextBlock Text="Документы сохраняются в локальной папке приложения. Формат .doc совместим с Word."
                                   Opacity="0.7" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </PivotItem>
                        </Pivot>
                        <Button Content="Сохранить настройки" Click="SaveSettingsButton_Click" Margin="0,12,0,4"/>
                        <Button Content="Сохранить резервную копию в Изображения" Click="ExportSettingsBackupButton_Click" Margin="0,4"/>
                        <Button Content="Восстановить настройки из резервной копии" Click="ImportSettingsBackupButton_Click" Margin="0,4,0,8"/>
                        <TextBlock Text="Файл ESP32-AI-Control-settings-backup.json хранится в общей папке Изображения телефона, вне данных приложения. После переустановки нажмите восстановление." TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,8"/>
                        <TextBlock x:Name="SettingsStatus" Text="" TextWrapping="Wrap"/>
                        
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Fixed bottom navigation inspired by the Android app. -->
        <Border Grid.Row="2" Background="#FF24252A"
                BorderBrush="#FF414141" BorderThickness="0,1,0,0">
            <Grid Background="#FF24252A">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="NavHomeButton" Grid.Column="0" Click="NavigateHome_Click"
                    Height="68" Padding="2" BorderThickness="0" FontSize="12">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="⌂" FontSize="23" HorizontalAlignment="Center"/>
                    <TextBlock Text="Главная" FontSize="12" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="NavMarfaButton" Grid.Column="1" Click="NavigateMarfa_Click"
                    Height="68" Padding="2" BorderThickness="0" FontSize="11"
                    AutomationProperties.Name="Голосовое управление Марфа">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid Width="24" Height="24" HorizontalAlignment="Center">
                        <Border Width="8" Height="14" CornerRadius="4"
                                Background="#FF8065E8" VerticalAlignment="Top"
                                HorizontalAlignment="Center" Margin="0,1,0,0"/>
                        <Border Width="17" Height="13" CornerRadius="7"
                                BorderBrush="#FF8065E8" BorderThickness="2"
                                Background="Transparent" VerticalAlignment="Top"
                                HorizontalAlignment="Center" Margin="0,5,0,0"/>
                        <Rectangle Width="2" Height="5" Fill="#FF8065E8"
                                   VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                   Margin="0,0,0,2"/>
                        <Rectangle Width="10" Height="2" Fill="#FF8065E8"
                                   VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="Марфа" FontSize="12" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="NavCommandsButton" Grid.Column="2" Click="NavigateCommands_Click"
                    Height="68" Padding="2" BorderThickness="0" FontSize="11">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="☷" FontSize="20" HorizontalAlignment="Center"/>
                    <TextBlock Text="Команды" FontSize="10" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="NavGraphsButton" Grid.Column="3" Click="NavigateGraphs_Click"
                    Height="68" Padding="2" BorderThickness="0" FontSize="11">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="▤" FontSize="20" HorizontalAlignment="Center"/>
