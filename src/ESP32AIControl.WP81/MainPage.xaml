<Page
    x:Class="ESP32AIControl.WP81.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Page.Resources>
        <SolidColorBrush x:Key="DashboardBackground" Color="#FF101116"/>
        <SolidColorBrush x:Key="DashboardSurface" Color="#FF1B1D24"/>
        <SolidColorBrush x:Key="DashboardText" Color="#FFF3F4F6"/>
        <SolidColorBrush x:Key="DashboardMuted" Color="#FF9CA3AF"/>
        <SolidColorBrush x:Key="DashboardBlue" Color="#FF1976D2"/>
        <SolidColorBrush x:Key="DashboardPurple" Color="#FFB15CFF"/>
    </Page.Resources>

    <Grid Background="{StaticResource DashboardBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="54"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="62"/>
        </Grid.RowDefinitions>

        <!-- Fixed application header -->
        <Border Grid.Row="0" Background="#FF171920" Padding="16,0"><Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="36"/>
                <ColumnDefinition Width="36"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="☰" FontSize="24" Foreground="{StaticResource DashboardText}"
                       VerticalAlignment="Center" HorizontalAlignment="Left"/>
            <TextBlock Grid.Column="1" Text="Dashboard" FontSize="23" FontWeight="SemiBold"
                       Foreground="{StaticResource DashboardText}" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="↻" FontSize="25" Foreground="{StaticResource DashboardText}"
                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="3" Text="⋮" FontSize="25" Foreground="{StaticResource DashboardText}"
                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </Grid></Border>

        <!-- Main sections; widget pages inside Dashboard remain horizontally swipeable. -->
        <Pivot x:Name="MainPivot" Grid.Row="1" Margin="0" Background="{StaticResource DashboardBackground}">
            <PivotItem Header="">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="14,4,14,8">
                    <StackPanel>
                        <Grid Margin="0,4,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ESP32 AI Control" FontSize="17" Foreground="{StaticResource DashboardMuted}"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="ConnectionText" Grid.Column="1" Text="MQTT: отключено"
                                       FontSize="13" Foreground="{StaticResource DashboardMuted}"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="Подключить" Click="ConnectButton_Click" Margin="0,0,8,0"
                                    Background="#FF1976D2" Foreground="White" Padding="12,6"/>
                            <Button Content="Отключить" Click="DisconnectButton_Click" Padding="12,6"/>
                            <Button Content="HELLO" Click="HelloButton_Click" Margin="8,0,0,0" Padding="12,6"/>
                        </StackPanel>

                        <!-- Voice / Marfa controls are intentionally hidden for this UI test phase. -->
                        <StackPanel Visibility="Collapsed">
                            <Button x:Name="VoiceButton" Content="Голос" Click="VoiceButton_Click"/>
                            <TextBlock x:Name="VoiceResultText" Text=""/>
                        </StackPanel>

                        <TextBlock Text="ВИДЖЕТЫ" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource DashboardMuted}" Margin="2,0,0,4"/>
                        <Pivot x:Name="WidgetPages" Height="470" Background="{StaticResource DashboardBackground}"/>

                        <TextBlock Text="ДИАГНОСТИКА MQTT" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource DashboardMuted}" Margin="2,12,0,6"/>
                        <Border Background="{StaticResource DashboardSurface}" Padding="8" MinHeight="90">
                            <ScrollViewer Height="120">
                                <TextBlock x:Name="LogText" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{StaticResource DashboardMuted}"/>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <PivotItem Header="">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="14,8,14,12">
                    <StackPanel>
                        <TextBlock Text="История измерений" FontSize="25" Foreground="{StaticResource DashboardText}"/>
                        <TextBlock Text="Запись производится с заданным интервалом, а не по каждому MQTT-пакету."
                                   TextWrapping="Wrap" Foreground="{StaticResource DashboardMuted}" Margin="0,4,0,10"/>
                        <ComboBox x:Name="GraphWidgetBox" Header="Датчик / виджет" Margin="0,4"/>
                        <StackPanel Orientation="Horizontal">
                            <DatePicker x:Name="GraphFrom" Header="С" Width="200" Margin="0,4,8,4"/>
                            <DatePicker x:Name="GraphTo" Header="По" Width="200" Margin="8,4,0,4"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,10">
                            <Button Content="Построить" Click="BuildGraphButton_Click" Margin="0,0,8,0"/>
                            <Button Content="Экспорт Word" Click="ExportGraphButton_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="GraphSummary" Text="—" Margin="0,0,0,8" Foreground="{StaticResource DashboardText}"/>
                        <Border BorderThickness="1" BorderBrush="#FF343741" Padding="4">
                            <Canvas x:Name="GraphCanvas" Height="340" MinWidth="420"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <PivotItem Header="">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="14,8,14,12">
                    <StackPanel>
                        <TextBlock Text="Запланированные команды" FontSize="25" Foreground="{StaticResource DashboardText}"/>
                        <TextBlock Text="Команда: device/widget=value" Foreground="{StaticResource DashboardMuted}" Margin="0,4,0,8"/>
                        <TextBox x:Name="ScheduleCommandBox" Header="Команда"/>
                        <StackPanel Orientation="Horizontal">
                            <DatePicker x:Name="ScheduleDate" Header="Дата" Width="210" Margin="0,4,8,4"/>
                            <TimePicker x:Name="ScheduleTime" Header="Время" Width="210" Margin="8,4,0,4"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,10">
                            <Button Content="Добавить" Click="AddScheduleButton_Click" Margin="0,0,6,0"/>
                            <Button Content="Изменить" Click="UpdateScheduleButton_Click" Margin="6,0"/>
                            <Button Content="Отменить" Click="CancelScheduleButton_Click" Margin="6,0"/>
                            <Button Content="Обновить" Click="RefreshScheduleButton_Click" Margin="6,0"/>
                        </StackPanel>
                        <ListView x:Name="ScheduleList" Height="420" SelectionChanged="ScheduleList_SelectionChanged"/>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <PivotItem Header="">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="14,8,14,12">
                    <StackPanel>
                        <TextBlock Text="Подключение" FontSize="25" Foreground="{StaticResource DashboardText}"/>
                        <TextBox x:Name="HostBox" Header="MQTT host" Text="m4.wqtt.ru"/>
                        <TextBox x:Name="PortBox" Header="TCP port" Text="2815"/>
                        <TextBox x:Name="PrefixBox" Header="MQTT prefix" Text="dghjko"/>
                        <TextBox x:Name="UserNameBox" Header="MQTT username"/>
                        <PasswordBox x:Name="PasswordBox" Header="MQTT password"/>

                        <TextBlock Text="Графики и хранение" FontSize="22" Margin="0,16,0,4" Foreground="{StaticResource DashboardText}"/>
                        <TextBox x:Name="MeasurementIntervalBox" Header="Интервал записи, секунд" Text="60"/>
                        <TextBox x:Name="RetentionDaysBox" Header="Период хранения, дней" Text="30"/>
                        <ComboBox x:Name="AutoExportBox" Header="Автоэкспорт Word">
                            <ComboBoxItem Content="Never" Tag="Never"/>
                            <ComboBoxItem Content="1 день" Tag="Day"/>
                            <ComboBoxItem Content="Неделя" Tag="Week"/>
                            <ComboBoxItem Content="Месяц" Tag="Month"/>
                        </ComboBox>

                        <TextBlock Text="Голосовое управление" FontSize="22" Margin="0,16,0,4" Foreground="{StaticResource DashboardText}"/>
                        <TextBox x:Name="VoiceOpenCommandBox" Header="Команда «открой теплицу»" PlaceholderText="device/widget=1"/>
                        <TextBox x:Name="VoiceCloseCommandBox" Header="Команда «закрой теплицу»" PlaceholderText="device/widget=0"/>

                        <TextBlock Text="Сценарий IoTManager" FontSize="22" Margin="0,16,0,4" Foreground="{StaticResource DashboardText}"/>
                        <TextBlock Text="Вставьте сюда блок scenario=> из export.json. Марфа ищет зависимости от реле вверх по условиям сценария."
                                   TextWrapping="Wrap" Foreground="{StaticResource DashboardMuted}"/>
                        <TextBox x:Name="ScenarioTextBox" Header="Сценарий" AcceptsReturn="True" TextWrapping="Wrap" Height="220"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="Импорт export.json" Click="ImportScenarioButton_Click" Margin="0,0,8,0"/>
                            <Button Content="Проверить план" Click="TestScenarioButton_Click"/>
                        </StackPanel>

                        <Button Content="Сохранить настройки" Click="SaveSettingsButton_Click" Margin="0,12,0,8"/>
                        <TextBlock x:Name="SettingsStatus" Text="" TextWrapping="Wrap" Foreground="{StaticResource DashboardText}"/>

                        <TextBlock Text="Word-экспорт" FontSize="22" Margin="0,18,0,4" Foreground="{StaticResource DashboardText}"/>
                        <Button Content="Экспорт всей истории за сегодня" Click="ExportTodayButton_Click"/>
                        <TextBlock Text="Документы сохраняются в локальной папке приложения. Формат .doc совместим с Word."
                                   Foreground="{StaticResource DashboardMuted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>
        </Pivot>

        <!-- Custom bottom navigation, above the Windows Phone system navigation keys -->
        <Border Grid.Row="2" Background="#FF171920" Padding="4,4,4,2"><Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="⌂&#x0a;Главная" Click="NavigateHome_Click" Background="Transparent"
                    Foreground="#FFB15CFF" FontSize="12" Padding="0" HorizontalAlignment="Stretch"/>
            <Button Grid.Column="1" Content="▥&#x0a;Графики" Click="NavigateGraphs_Click" Background="Transparent"
                    Foreground="{StaticResource DashboardMuted}" FontSize="12" Padding="0" HorizontalAlignment="Stretch"/>
            <Button Grid.Column="2" Content="◷&#x0a;Задачи" Click="NavigateTasks_Click" Background="Transparent"
                    Foreground="{StaticResource DashboardMuted}" FontSize="12" Padding="0" HorizontalAlignment="Stretch"/>
            <Button Grid.Column="3" Content="⚙&#x0a;Настройки" Click="NavigateSettings_Click" Background="Transparent"
                    Foreground="{StaticResource DashboardMuted}" FontSize="12" Padding="0" HorizontalAlignment="Stretch"/>
        </Grid></Border>
    </Grid>
</Page>