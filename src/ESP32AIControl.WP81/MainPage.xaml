<Page
    x:Class="ESP32AIControl.WP81.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Page.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#FFD0BCFF"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#FF2B2C34"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#FFACADB8"/>
        <SolidColorBrush x:Key="CardBrush" Color="#FF30313A"/>
        <SolidColorBrush x:Key="FieldBrush" Color="#FF25262D"/>
        <SolidColorBrush x:Key="LineBrush" Color="#FF41434D"/>
        <DataTemplate x:Key="WidgetPageHeaderTemplate">
            <Border Background="#FF30313A" CornerRadius="8" Padding="7,4" Margin="0,0,4,0">
                <TextBlock Text="{Binding}" FontSize="12" FontWeight="SemiBold"
                           FontFamily="Segoe UI Symbol"
                           Foreground="#FFEAF1F7" TextWrapping="NoWrap"/>
            </Border>
        </DataTemplate>
        <!-- Unified Android-like settings category tabs for every settings subsection. -->
        <DataTemplate x:Key="SettingsPivotHeaderTemplate">
            <Border Background="#FF30313A" BorderBrush="#FF41434D" BorderThickness="1"
                    CornerRadius="18" Padding="14,8" Margin="0,0,6,0">
                <TextBlock Text="{Binding}" FontSize="13" FontWeight="SemiBold"
                           Foreground="#FFEAF1F7" VerticalAlignment="Center"
                           TextWrapping="NoWrap"/>
            </Border>
        </DataTemplate>
        <Style x:Key="SettingsSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FFD0BCFF"/>
            <Setter Property="Margin" Value="0,18,0,6"/>
        </Style>
        <Style x:Key="SettingsDescriptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#FFACADB8"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFEAF1F7"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF343540"/>
            <Setter Property="Foreground" Value="#FFEAF1F7"/>
            <Setter Property="BorderBrush" Value="#FF4A4B56"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="MinHeight" Value="48"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF25262D"/>
            <Setter Property="Foreground" Value="#FFEAF1F7"/>
            <Setter Property="BorderBrush" Value="#FF4B4C58"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,7,0,7"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#FF2B2B2B"/>
            <Setter Property="Foreground" Value="#FFEAF1F7"/>
            <Setter Property="BorderBrush" Value="#FF555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,7,0,7"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#FF25262D"/>
            <Setter Property="Foreground" Value="#FFEAF1F7"/>
            <Setter Property="BorderBrush" Value="#FF4B4C58"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinHeight" Value="48"/>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Foreground" Value="#FFEAF1F7"/>
            <Setter Property="Background" Value="#FF25262D"/>
            <Setter Property="BorderBrush" Value="#FF4B4C58"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>
        <Style TargetType="TimePicker">
            <Setter Property="Foreground" Value="#FFEAF1F7"/>
            <Setter Property="Background" Value="#FF25262D"/>
            <Setter Property="BorderBrush" Value="#FF4B4C58"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>
        <Style TargetType="Slider"><Setter Property="Foreground" Value="#FFD0BCFF"/></Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#FFEAF1F7"/></Style>
        <Style TargetType="ListView">
            <Setter Property="Background" Value="#FF25262D"/>
            <Setter Property="Foreground" Value="#FFEAF1F7"/>
            <Setter Property="BorderBrush" Value="#FF41434D"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="ListViewItem">
            <Setter Property="Background" Value="#FF30313A"/>
            <Setter Property="Foreground" Value="#FFEAF1F7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
        </Style>
    </Page.Resources>
    <Grid Background="#FF202020">
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>

        <!-- Android-like top bar: menu, current screen title, info and MQTT cloud status. -->
        <Border Grid.Row="0" Background="#FF202020" BorderBrush="#FF41434D"
                BorderThickness="0,0,0,1" Padding="8,4,8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="38"/>
                    <ColumnDefinition Width="35"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="MenuButton" Grid.Column="0"
                        Click="MenuButton_Click" Background="Transparent"
                        BorderThickness="0" Padding="0"
                        Foreground="#FFEAF1F7" VerticalAlignment="Center"
                        HorizontalAlignment="Center" Width="40" Height="48"
                        AutomationProperties.Name="Открыть меню">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="27">
                        <Border Height="3" Background="#FFEAF1F7" CornerRadius="1" Margin="0,0,0,5"/>
                        <Border Height="3" Background="#FFEAF1F7" CornerRadius="1" Margin="0,0,0,5"/>
                        <Border Height="3" Background="#FFEAF1F7" CornerRadius="1"/>
                    </StackPanel>
                </Button>
                <TextBlock x:Name="PageSubtitle" Grid.Column="1" Text="Главная"
                           FontSize="18" FontWeight="SemiBold" Foreground="#FFEAF1F7"
                           VerticalAlignment="Center" HorizontalAlignment="Left"
                           Margin="4,0,0,0"
                           TextAlignment="Center" TextWrapping="NoWrap"/>
                <Button x:Name="TopInfoButton" Grid.Column="2" Content="ⓘ"
                        Click="TopInfoButton_Click" Background="Transparent"
                        BorderThickness="0" Padding="0" FontSize="20"
                        Foreground="#FFEAF1F7" VerticalAlignment="Stretch"/>
                <TextBlock x:Name="TopConnectionDot" Grid.Column="3" Text="☁"
                           FontSize="22" Foreground="#FFF44336"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid x:Name="MainSections" Grid.Row="1" Background="#FF202020">
<Grid x:Name="HomeSection" Visibility="Visible">
                <Grid Margin="10,0,10,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Page tabs and live widgets are the focus of the Android dashboard. -->
                    <Grid Grid.Row="0">
                        <Pivot x:Name="WidgetPages" Margin="0"
                               HeaderTemplate="{StaticResource WidgetPageHeaderTemplate}"/>
                        <Border x:Name="DashboardEmptyOverlay" Background="#FF2B2C34" BorderBrush="#FF41434D"
                                BorderThickness="1" CornerRadius="16" Padding="22"
                                Margin="24" IsHitTestVisible="False" Visibility="Visible">
                            <StackPanel x:Name="DashboardEmptyState" VerticalAlignment="Center"
                                        HorizontalAlignment="Center">
                                <TextBlock Text="Дашборд" FontSize="25" FontWeight="SemiBold"
                                           Foreground="#FFD0BCFF" HorizontalAlignment="Center"/>
                                <TextBlock Text="Здесь появятся виджеты теплиц"
                                           FontSize="16" Foreground="#FFEAF1F7"
                                           TextAlignment="Center" Margin="0,12,0,4"/>
                                <TextBlock Text="Откройте меню ☰ и подключитесь к MQTT в настройках."
                                           FontSize="13" Foreground="#FFACADB8"
                                           TextAlignment="Center" TextWrapping="Wrap"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- The bottom-nav microphone reports recognition here without taking dashboard space. -->
                    <Border Grid.Row="1" Background="#FF2B2C34"
                            BorderBrush="#FF41434D" BorderThickness="1"
                            CornerRadius="14" Padding="10" Margin="6,2,6,6">
                        <StackPanel>
                            <TextBlock Text="МАРФА · ГОЛОСОВОЕ УПРАВЛЕНИЕ"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="#FFD0BCFF" Margin="0,0,0,3"/>
                            <TextBlock x:Name="VoiceResultText"
                                       Text="Нажмите «Марфа», чтобы произнести команду"
                                       Foreground="#FFACADB8" FontSize="12"
                                       TextWrapping="Wrap" MaxHeight="42"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <Grid x:Name="GraphsSection" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12,10,12,12">
                    <StackPanel>
                        <StackPanel Margin="4,4,4,12">
                            
                            <TextBlock Text="История и графики" FontSize="24" FontWeight="SemiBold" Margin="0,2,0,2"/>
                            <TextBlock Text="Изменение показаний датчиков за выбранный период." FontSize="13" Foreground="#FFACADB8"/>
                        </StackPanel>
                        <Border Background="#FF2B2C34" CornerRadius="16" BorderBrush="#FF41434D" BorderThickness="1" Padding="12" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Датчики с историей" FontSize="17" FontWeight="SemiBold" Margin="2,0,2,6"/>
                                <TextBlock Text="Выберите числовой датчик, чтобы открыть его график и последние измерения." FontSize="12" Foreground="#FFACADB8" TextWrapping="Wrap" Margin="2,0,2,6"/>
                                <ListView x:Name="HistoryWidgetList" Height="220" SelectionMode="Single" SelectionChanged="HistoryWidgetList_SelectionChanged"/>
                            </StackPanel>
                        </Border>
                        <Button Content="⚙ Настройки истории и графиков" Click="ToggleGraphSettingsButton_Click" HorizontalAlignment="Stretch" Margin="0,0,0,8" MinHeight="44"/>
                        <Border x:Name="GraphSettingsCard" Visibility="Collapsed" Background="#FF2B2C34" CornerRadius="16" BorderBrush="#FF41434D" BorderThickness="1" Padding="14" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Параметры графика" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <ComboBox x:Name="GraphWidgetBox" Header="Датчик или виджет" Margin="0,2,0,8"/><StackPanel Orientation="Horizontal" Margin="0,2,0,8"><Button Content="Добавить в сравнение" Click="AddCompareWidgetButton_Click" Margin="0,0,6,0"/><Button Content="Очистить список" Click="ClearCompareWidgetsButton_Click"/></StackPanel><ListView x:Name="GraphCompareList" Height="110" SelectionMode="Single" Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8"><ComboBox x:Name="GraphColorBox" Header="Цвет выбранного датчика" Width="190"><ComboBoxItem Content="Синий" Tag="Blue"/><ComboBoxItem Content="Оранжевый" Tag="Orange"/><ComboBoxItem Content="Зелёный" Tag="Green"/><ComboBoxItem Content="Пурпурный" Tag="Magenta"/><ComboBoxItem Content="Бирюзовый" Tag="Cyan"/><ComboBoxItem Content="Жёлтый" Tag="Yellow"/></ComboBox><Button Content="Применить цвет" Click="ApplyCompareColorButton_Click" VerticalAlignment="Bottom" Margin="8,0,0,0"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,8"><Button Content="Удалить выбранный" Click="RemoveCompareWidgetButton_Click" Margin="0,0,6,0"/><Button Content="Построить сравнение" Click="BuildCompareGraphButton_Click"/></StackPanel><TextBox x:Name="GraphSetNameBox" Header="Название набора" PlaceholderText="Например: температура"/><StackPanel Orientation="Horizontal" Margin="0,0,0,8"><Button Content="Сохранить набор" Click="SaveGraphSetButton_Click" Margin="0,0,6,0"/><Button Content="Загрузить" Click="LoadGraphSetButton_Click"/></StackPanel><ComboBox x:Name="GraphSavedSetsBox" Header="Сохранённые наборы" Margin="0,0,0,8"/><Button Content="Удалить набор" Click="DeleteGraphSetButton_Click" Margin="0,0,0,8"/><TextBlock Text="Быстрый период:" Foreground="#FFACADB8" Margin="0,0,0,4"/><StackPanel Orientation="Horizontal"><Button Content="Сегодня" Click="GraphPresetDayButton_Click" Margin="0,0,4,0"/><Button Content="7 дней" Click="GraphPresetWeekButton_Click" Margin="0,0,4,0"/><Button Content="30 дней" Click="GraphPresetMonthButton_Click"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,4,0,8"><TextBox x:Name="WidgetIntervalBox" Header="Интервал записи (сек)" Width="170" PlaceholderText="Общий интервал"/><Button Content="Сохранить интервал" Click="SaveWidgetIntervalButton_Click" VerticalAlignment="Bottom" Margin="8,0,0,0"/></StackPanel><TextBlock x:Name="WidgetIntervalStatus" Text="Интервал выбранного датчика" Foreground="#FFACADB8" FontSize="12" TextWrapping="Wrap" Margin="2,0,2,8"/>
                                <ComboBox x:Name="GraphPeriodBox" Header="Период отображения" SelectedIndex="3" Margin="0,0,0,8">
                                    <ComboBoxItem Content="1 час" Tag="1h"/><ComboBoxItem Content="6 часов" Tag="6h"/><ComboBoxItem Content="12 часов" Tag="12h"/><ComboBoxItem Content="Сегодня" Tag="today"/><ComboBoxItem Content="3 дня" Tag="3d"/><ComboBoxItem Content="7 дней" Tag="7d"/><ComboBoxItem Content="30 дней" Tag="30d"/><ComboBoxItem Content="Весь срок" Tag="all"/><ComboBoxItem Content="Произвольный период" Tag="custom"/>
                                </ComboBox>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <DatePicker x:Name="GraphFrom" Header="Начало периода" Margin="0,2,5,2"/>
                                    <DatePicker x:Name="GraphTo" Grid.Column="1" Header="Конец периода" Margin="5,2,0,2"/>
                                </Grid>
                                <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Button Content="Построить график" Click="BuildGraphButton_Click" Background="#FFD0BCFF" BorderBrush="#FFD0BCFF" Foreground="#FF202020" FontWeight="SemiBold" Margin="0,0,5,0"/>
                                    <Button Grid.Column="1" Content="Экспорт Word" Click="ExportGraphButton_Click" Margin="5,0,0,0"/>
                                </Grid>
                                <Button Content="Экспорт сравнения в CSV" Click="ExportCompareCsvButton_Click" Margin="0,8,0,0"/>
                                <Button Content="Экспорт сравнения в Word" Click="ExportCompareWordButton_Click" Margin="0,6,0,0"/>
                                <Button Content="Очистить историю измерений" Click="ClearHistoryButton_Click" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#FF2B2C34" CornerRadius="16" BorderBrush="#FF41434D" BorderThickness="1" Padding="12" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Результат" FontSize="17" FontWeight="SemiBold" Margin="2,0,2,4"/>
                                <TextBlock x:Name="GraphSummary" Text="Выберите датчик и период" Foreground="#FFACADB8" FontSize="12" TextWrapping="Wrap" Margin="2,0,2,8"/>
                                <TextBlock x:Name="GraphSelectedPoint" Text="Выберите точку на графике" Foreground="#FFD0BCFF" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="2,0,2,8"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,6">
                                    <Button Content="−" Click="ZoomOutGraphButton_Click" MinWidth="44" MinHeight="40"/>
                                    <TextBlock x:Name="GraphZoomLabel" Text="×1,0" VerticalAlignment="Center" Margin="8,0"/>
                                    <Button Content="＋" Click="ZoomInGraphButton_Click" MinWidth="44" MinHeight="40"/>
                                    <Button Content="Сброс" Click="ResetGraphZoomButton_Click" MinHeight="40" Margin="6,0,0,0"/>
                                </StackPanel>
                                <Border Background="#FF202020" CornerRadius="10" Padding="6">
                                    <ScrollViewer x:Name="GraphHorizontalScroll" Height="320"
                                                  HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Disabled">
                                        <Canvas x:Name="GraphCanvas" Height="300" HorizontalAlignment="Left" ManipulationMode="Scale,Translate" ManipulationDelta="GraphCanvas_ManipulationDelta" />
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Запись показаний выполняется с заданным интервалом, а не по каждому MQTT-пакету." FontSize="12" Foreground="#FFACADB8" TextWrapping="Wrap" Margin="4,2,4,8"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid x:Name="TasksSection" Visibility="Collapsed">
                <Grid Margin="12,10,12,12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="4,4,4,12">
                        
                        <TextBlock Text="Планировщик команд ESP32" FontSize="18" FontWeight="SemiBold" Foreground="#FFD0BCFF" Margin="0,2,0,2"/>
                        <TextBlock Text="Команда будет отправлена устройству в указанное время." FontSize="12" Foreground="#FFACADB8" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border Grid.Row="1" Background="#FF2B2C34" CornerRadius="16" BorderBrush="#FF41434D" BorderThickness="1" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Новая команда" FontSize="15" FontWeight="SemiBold" Foreground="#FFD0BCFF" Margin="2,0,2,4"/>
                            <TextBox x:Name="ScheduleCommandBox" Header="Команда устройству" PlaceholderText="device/widget=value"/>
                            <Grid Margin="0,2,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <DatePicker x:Name="ScheduleDate" Header="Дата" HorizontalAlignment="Stretch" Margin="0,2,5,2"/>
                                <TimePicker x:Name="ScheduleTime" Grid.Column="1" Header="Время" HorizontalAlignment="Stretch" Margin="5,2,0,2"/>
                            </Grid>
                            <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Button Content="Добавить" Click="AddScheduleButton_Click" Background="#FFD0BCFF" BorderBrush="#FFD0BCFF" Foreground="#FF202020" FontWeight="SemiBold" Margin="0,0,5,5"/>
                                <Button Grid.Column="1" Content="Изменить" Click="UpdateScheduleButton_Click" Margin="5,0,0,5"/>
                                <Button Grid.Row="1" Content="Отменить" Click="CancelScheduleButton_Click" Margin="0,5,5,0"/>
                                <Button Grid.Row="1" Grid.Column="1" Content="Обновить список" Click="RefreshScheduleButton_Click" Margin="5,5,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="2" Background="#FF2B2C34" CornerRadius="16" BorderBrush="#FF41434D" BorderThickness="1" Padding="10">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,2,8">
                                <TextBlock Text="Запланировано" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="  •  выберите запись для изменения" FontSize="10" Foreground="#FFACADB8" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ListView x:Name="ScheduleList" Grid.Row="1" SelectionChanged="ScheduleList_SelectionChanged" Background="#FF25262D" BorderThickness="0"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <Grid x:Name="SettingsSection" Visibility="Collapsed">
                <Grid Margin="12,8,12,8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="4,2,4,8">
                        
                        <TextBlock Text="Настройки" FontSize="24" FontWeight="SemiBold" Margin="0,1,0,1"/>
                        <TextBlock Text="Подключение · хранение · профили · голос · сценарии · журнал" FontSize="12" Foreground="#FFACADB8" TextWrapping="Wrap"/>
                    </StackPanel>
                                            <Pivot x:Name="SettingsPivot" Grid.Row="1" Background="#FF202020" Foreground="#FFEAF1F7"
                           HeaderTemplate="{StaticResource SettingsPivotHeaderTemplate}">
                <PivotItem Header="Подключение">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10,4,10,12">
                            <StackPanel Margin="2,8,2,10">
                                <TextBlock Text="Подключение" FontSize="21" FontWeight="SemiBold" Foreground="#FFEAF1F7" Margin="0,0,0,3"/>
                                <TextBlock Text="Настройте MQTT-сервер, параметры клиента и состояние соединения с контроллером." FontSize="12" Foreground="#FFACADB8" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Border Background="#FF2B2C34" BorderBrush="#FF41434D" BorderThickness="1" CornerRadius="14" Padding="12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="MQTT-СЕРВЕР" FontSize="14" FontWeight="SemiBold" Foreground="#FFD0BCFF" Margin="0,0,0,3"/>
                                    <TextBlock Text="Адрес брокера и пространство MQTT-топиков." FontSize="12" Foreground="#FFACADB8" TextWrapping="Wrap" Margin="0,0,0,5"/>
                                    <TextBox x:Name="HostBox" Header="MQTT сервер или адрес" Text="m4.wqtt.ru" LostFocus="MqttSetting_LostFocus"/>
                                    <TextBox x:Name="PortBox" Header="Порт подключения" Text="2815" LostFocus="MqttSetting_LostFocus"/>
                                    <TextBox x:Name="PrefixBox" Header="Префикс MQTT" Text="dghjko" LostFocus="MqttSetting_LostFocus"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#FF2B2C34" BorderBrush="#FF41434D" BorderThickness="1" CornerRadius="14" Padding="12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="УЧЁТНАЯ ЗАПИСЬ КЛИЕНТА" FontSize="14" FontWeight="SemiBold" Foreground="#FFD0BCFF" Margin="0,0,0,3"/>
                                    <TextBlock Text="Данные авторизации и уникальный идентификатор этого приложения." FontSize="12" Foreground="#FFACADB8" TextWrapping="Wrap" Margin="0,0,0,5"/>
                                    <TextBox x:Name="UserNameBox" Header="Имя пользователя" LostFocus="MqttSetting_LostFocus"/>
                                    <PasswordBox x:Name="PasswordBox" Header="Пароль MQTT" LostFocus="MqttSetting_LostFocus"/>
                                    <TextBox x:Name="ClientIdBox" Header="Идентификатор клиента" Text="ESP32-AI-Control-WP81" LostFocus="MqttSetting_LostFocus"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#FF2B2C34" BorderBrush="#FF41434D" BorderThickness="1" CornerRadius="14" Padding="12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="ЗАЩИТА СОЕДИНЕНИЯ" FontSize="14" FontWeight="SemiBold" Foreground="#FFD0BCFF" Margin="0,0,0,4"/>
                                    <CheckBox x:Name="MqttTlsCheckBox" Content="Использовать защищённое TLS-соединение" Margin="0,4,0,2" Checked="MqttTlsCheckBox_Changed" Unchecked="MqttTlsCheckBox_Changed"/>
                                    <TextBlock Text="Включайте TLS, если выбранный MQTT-брокер поддерживает защищённое подключение на указанном порту." FontSize="12" Foreground="#FFACADB8" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
