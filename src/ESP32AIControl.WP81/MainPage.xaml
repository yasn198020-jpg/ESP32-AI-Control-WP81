<Page
    x:Class="ESP32AIControl.WP81.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#FF202020">
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="64"/>
        </Grid.RowDefinitions>

        <!-- Common app bar, matching the Android screen structure. -->
        <Grid Grid.Row="0" Background="#FF202020" Margin="8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="66"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="MenuButton"
                    Grid.Column="0"
                    Content="☰"
                    FontSize="28"
                    Foreground="#FFF2F2F2"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    Click="MenuButton_Click"/>

            <TextBlock x:Name="PageTitleText"
                       Grid.Column="1"
                       Text="Главная"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="#FFF5F5F5"
                       VerticalAlignment="Center"
                       Margin="8,0,0,0"/>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <Ellipse x:Name="ConnectionIndicator"
                         Width="10"
                         Height="10"
                         Fill="#FFB00020"
                         VerticalAlignment="Center"/>
                <TextBlock x:Name="TopConnectionText"
                           Text="OFF"
                           FontSize="11"
                           Foreground="#FFBDBDBD"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Pivot x:Name="MainPivot"
               Grid.Row="1"
               Background="#FF202020"
               SelectionChanged="MainPivot_SelectionChanged">
            <Pivot.HeaderTemplate>
                <DataTemplate>
                    <TextBlock Visibility="Collapsed" Height="0"/>
                </DataTemplate>
            </Pivot.HeaderTemplate>

            <!-- 0: Home -->
            <PivotItem Header="Главная">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="14,8,14,12">
                    <StackPanel>
                        <TextBlock Text="ESP32 AI Control"
                                   FontSize="26"
                                   FontWeight="SemiBold"
                                   Foreground="#FFF5F5F5"/>
                        <TextBlock Text="Устройства и датчики"
                                   FontSize="14"
                                   Foreground="#FF9E9E9E"
                                   Margin="0,2,0,10"/>

                        <Border Background="#FF2B2B2B"
                                BorderBrush="#FF393B44"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="12"
                                Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock x:Name="ConnectionText"
                                           Text="MQTT: отключено"
                                           FontSize="16"
                                           Foreground="#FFECEFF1"
                                           Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Подключить"
                                            Click="ConnectButton_Click"
                                            Margin="0,0,6,0"/>
                                    <Button Content="Отключить"
                                            Click="DisconnectButton_Click"
                                            Margin="0,0,6,0"/>
                                    <Button Content="HELLO"
                                            Click="HelloButton_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button x:Name="VoiceButton"
                                    Content="🎙 Сказать Марфе"
                                    Click="VoiceButton_Click"
                                    Margin="0,0,8,0"/>
                            <TextBlock x:Name="VoiceResultText"
                                       Text="Голосовое управление готово"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       Foreground="#FFBDBDBD"/>
                        </StackPanel>

                        <TextBlock Text="Виджеты ESP32"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#FFF5F5F5"
                                   Margin="0,8,0,8"/>
                        <Pivot x:Name="WidgetPages" Height="430"/>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <!-- 1: Marfa voice screen -->
            <PivotItem Header="Марфа">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="14,12,14,12">
                    <StackPanel>
                        <TextBlock Text="Марфа"
                                   FontSize="27"
                                   FontWeight="SemiBold"
                                   Foreground="#FFF5F5F5"/>
                        <TextBlock Text="Голосовой помощник ESP32 AI Control"
                                   FontSize="14"
                                   Foreground="#FF9E9E9E"
                                   Margin="0,3,0,14"/>
                        <Border Background="#FF2B2B2B"
                                BorderBrush="#FF393B44"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16">
                            <StackPanel>
                                <TextBlock Text="Голосовое управление"
                                           FontSize="19"
                                           FontWeight="SemiBold"
                                           Foreground="#FFECEFF1"/>
                                <TextBlock x:Name="MarfaVoiceResultText"
                                           Text="Нажмите кнопку и произнесите действие и название управляемого элемента. Перед отправкой Марфа попросит подтверждение."
                                           TextWrapping="Wrap"
                                           Foreground="#FFBDBDBD"
                                           Margin="0,10,0,12"/>
                                <Button x:Name="MarfaListenButton"
                                        Content="🎙 Слушать"
                                        HorizontalAlignment="Stretch"
                                        Click="MarfaListenButton_Click"/>
                            </StackPanel>
                        </Border>
                        <Button Content="Настроить голосовые команды"
                                HorizontalAlignment="Stretch"
                                Click="NavigateSettings_Click"
                                Margin="0,12,0,0"/>
                        <Button Content="Посмотреть команды"
                                HorizontalAlignment="Stretch"
                                Click="CommandsNavigation_Click"
                                Margin="0,8,0,0"/>
                        <TextBlock Text="В WP81 используется штатное распознавание речи Windows Phone. Непрерывное фоновое пробуждение здесь пока не реализовано."
                                   TextWrapping="Wrap"
                                   Foreground="#FF9E9E9E"
                                   FontSize="12"
                                   Margin="0,14,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <!-- 1: Commands. This first phase exposes the two existing voice actions. -->
            <PivotItem Header="Команды">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="14,12,14,12">
                    <StackPanel>
                        <TextBlock Text="Голосовые команды"
                                   FontSize="25"
                                   FontWeight="SemiBold"
                                   Foreground="#FFF5F5F5"/>
                        <TextBlock Text="Здесь находятся дополнительные команды открытия и закрытия теплицы. Также Марфа может найти отдельный переключатель или кнопку по названию MQTT-элемента."
                                   TextWrapping="Wrap"
                                   Foreground="#FFBDBDBD"
                                   Margin="0,4,0,14"/>

                        <Border Background="#FF2B2B2B"
                                BorderBrush="#FF393B44"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="14"
                                Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Открыть теплицу"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Foreground="#FFF5F5F5"/>
                                <TextBlock x:Name="OpenCommandSummary"
                                           Text="Команда не настроена"
                                           TextWrapping="Wrap"
                                           Foreground="#FFBDBDBD"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#FF2B2B2B"
                                BorderBrush="#FF393B44"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="14"
                                Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Закрыть теплицу"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Foreground="#FFF5F5F5"/>
                                <TextBlock x:Name="CloseCommandSummary"
                                           Text="Команда не настроена"
                                           TextWrapping="Wrap"
                                           Foreground="#FFBDBDBD"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <Button Content="Настроить команды"
                                HorizontalAlignment="Stretch"
                                Click="NavigateSettings_Click"
                                Margin="0,4,0,8"/>
                        <Button x:Name="CommandVoiceButton"
                                Content="Произнести команду"
                                HorizontalAlignment="Stretch"
                                Click="VoiceButton_Click"/>
                        <TextBlock x:Name="VoiceStatusText"
                                   Text="Голосовое управление готово"
                                   Foreground="#FFBDBDBD"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"/>
                        <TextBlock Text="Поддерживаются одиночные команды с однозначным совпадением. Несколько действий в одной фразе и полноценный диалог уточнений пока не перенесены; неоднозначная команда не отправляется."
                                   TextWrapping="Wrap"
                                   Foreground="#FF9E9E9E"
                                   FontSize="12"
                                   Margin="0,12,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <!-- 2: History and charts -->
            <PivotItem Header="История">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="14,10,14,12">
                    <StackPanel>
                        <TextBlock Text="История и графики"
                                   FontSize="25"
                                   FontWeight="SemiBold"
                                   Foreground="#FFF5F5F5"/>
                        <TextBlock Text="Выберите датчик и период для просмотра сохранённых измерений."
                                   TextWrapping="Wrap"
                                   Foreground="#FFBDBDBD"
                                   Margin="0,4,0,10"/>
                        <ComboBox x:Name="GraphWidgetBox" Header="Датчик / виджет" Margin="0,4"/>
                        <StackPanel Orientation="Horizontal">
                            <DatePicker x:Name="GraphFrom" Header="С" Width="200" Margin="0,4,8,4"/>
                            <DatePicker x:Name="GraphTo" Header="По" Width="200" Margin="8,4,0,4"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,10">
                            <Button Content="Построить" Click="BuildGraphButton_Click" Margin="0,0,8,0"/>
                            <Button Content="Экспорт Word" Click="ExportGraphButton_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="GraphSummary"
                                   Text="—"
                                   Margin="0,0,0,8"
                                   Foreground="#FFBDBDBD"/>
                        <Border Background="#FF2B2B2B"
                                BorderBrush="#FF393B44"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="6">
                            <Canvas x:Name="GraphCanvas" Height="340" MinWidth="420"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <!-- 3: Deferred commands -->
            <PivotItem Header="Отложенные">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="14,10,14,12">
                    <StackPanel>
                        <TextBlock Text="Отложенные команды"
                                   FontSize="25"
                                   FontWeight="SemiBold"
                                   Foreground="#FFF5F5F5"/>
                        <TextBlock Text="Команда будет отправлена ESP32 в указанное время."
                                   Foreground="#FFBDBDBD"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,8"/>
                        <TextBox x:Name="ScheduleCommandBox" Header="Команда"/>
                        <StackPanel Orientation="Horizontal">
                            <DatePicker x:Name="ScheduleDate" Header="Дата" Width="210" Margin="0,4,8,4"/>
                            <TimePicker x:Name="ScheduleTime" Header="Время" Width="210" Margin="8,4,0,4"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                            <Button Content="Добавить" Click="AddScheduleButton_Click" Margin="0,0,6,0"/>
                            <Button Content="Изменить" Click="UpdateScheduleButton_Click" Margin="6,0"/>
                            <Button Content="Отменить" Click="CancelScheduleButton_Click" Margin="6,0"/>
                            <Button Content="Обновить" Click="RefreshScheduleButton_Click" Margin="6,0"/>
                        </StackPanel>
                        <Button Content="Повторить ошибочную задачу"
                                Click="RetryScheduleButton_Click"
                                HorizontalAlignment="Stretch"
                                Margin="0,2,0,4"/>
                        <TextBlock x:Name="ScheduleStatusText"
                                   Text="Выберите задачу для просмотра состояния."
                                   TextWrapping="Wrap"
                                   Foreground="#FFBDBDBD"
                                   Margin="0,4,0,6"/>
                        <ListView x:Name="ScheduleList"
                                  Height="420"
                                  SelectionChanged="ScheduleList_SelectionChanged"/>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <!-- 4: Settings -->
            <PivotItem Header="Настройки">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="14,10,14,12">
                    <StackPanel>
                        <TextBlock Text="Настройки"
                                   FontSize="25"
                                   FontWeight="SemiBold"
                                   Foreground="#FFF5F5F5"/>
                        <TextBlock Text="Подключение MQTT"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Foreground="#FFECEFF1"
                                   Margin="0,12,0,4"/>
                        <TextBox x:Name="HostBox" Header="MQTT host" Text="m4.wqtt.ru"/>
                        <TextBox x:Name="PortBox" Header="TCP port" Text="2815"/>
                        <TextBox x:Name="PrefixBox" Header="MQTT prefix" Text="dghjko"/>
                        <TextBox x:Name="UserNameBox" Header="MQTT username"/>
                        <PasswordBox x:Name="PasswordBox" Header="MQTT password"/>

                        <TextBlock Text="История и хранение"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Foreground="#FFECEFF1"
                                   Margin="0,16,0,4"/>
                        <TextBox x:Name="MeasurementIntervalBox" Header="Интервал записи, секунд" Text="60"/>
                        <TextBox x:Name="RetentionDaysBox" Header="Период хранения, дней" Text="30"/>
                        <ComboBox x:Name="AutoExportBox" Header="Автоэкспорт Word">
                            <ComboBoxItem Content="Never" Tag="Never"/>
                            <ComboBoxItem Content="1 день" Tag="Day"/>
                            <ComboBoxItem Content="Неделя" Tag="Week"/>
                            <ComboBoxItem Content="Месяц" Tag="Month"/>
                        </ComboBox>

                        <TextBlock Text="Голосовое управление"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Foreground="#FFECEFF1"
                                   Margin="0,16,0,4"/>
                        <TextBox x:Name="VoiceOpenCommandBox"
                                 Header="Команда «открой теплицу»"
                                 PlaceholderText="device/widget=1"/>
                        <TextBox x:Name="VoiceCloseCommandBox"
                                 Header="Команда «закрой теплицу»"
                                 PlaceholderText="device/widget=0"/>

                        <Button Content="Сохранить настройки"
                                Click="SaveSettingsButton_Click"
                                Margin="0,14,0,8"
                                HorizontalAlignment="Stretch"/>
                        <TextBlock x:Name="SettingsStatus"
                                   Text=""
                                   TextWrapping="Wrap"
                                   Foreground="#FFBDBDBD"/>

                        <TextBlock Text="Word-экспорт"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Foreground="#FFECEFF1"
                                   Margin="0,18,0,4"/>
                        <Button Content="Экспорт всей истории за сегодня"
                                Click="ExportTodayButton_Click"
                                HorizontalAlignment="Stretch"/>
                        <TextBlock Text="Документы сохраняются в локальной папке приложения."
                                   Foreground="#FF9E9E9E"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <!-- 5: Existing IoTManager scenario import and analysis, moved out of settings. -->
            <PivotItem Header="Сценарии">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="14,10,14,12">
                    <StackPanel>
                        <TextBlock Text="Логика устройств"
                                   FontSize="25"
                                   FontWeight="SemiBold"
                                   Foreground="#FFF5F5F5"/>
                        <TextBlock Text="Импортируйте блок scenario=> из export.json. Проверка понимает вложенные IF/THEN/ELSE, выражения и время; после получения MQTT-данных отслеживает отклонения от активных сценариев."
                                   TextWrapping="Wrap"
                                   Foreground="#FFBDBDBD"
                                   Margin="0,4,0,10"/>
                        <TextBlock Text="Сохранённые сценарии"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#FFECEFF1"
                                   Margin="0,4,0,4"/>
                        <ListView x:Name="ScenarioList"
                                  Height="150"
                                  SelectionChanged="ScenarioList_SelectionChanged"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,10">
                            <Button Content="Новый сценарий"
                                    Click="NewScenarioButton_Click"
                                    Margin="0,0,8,0"/>
                            <Button Content="Удалить выбранный"
                                    Click="DeleteScenarioButton_Click"/>
                        </StackPanel>
                        <TextBox x:Name="ScenarioTitleBox"
                                 Header="Название сценария"
                                 Margin="0,2,0,4"/>
                        <CheckBox x:Name="ScenarioEnabledCheckBox"
                                  Content="Сценарий активен"
                                  Margin="0,4,0,8"/>
                        <TextBlock Text="Код IoTManager"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#FFECEFF1"
                                   Margin="0,4,0,4"/>
                        <TextBox x:Name="ScenarioTextBox"
                                 Header="Содержимое сценария"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Height="300"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Импорт export.json"
                                    Click="ImportScenarioButton_Click"
                                    Margin="0,0,8,0"/>
                            <Button Content="Проверить план"
                                    Click="TestScenarioButton_Click"
                                    Margin="0,0,8,0"/>
                            <Button Content="Очистить поле"
                                    Click="ClearScenarioButton_Click"/>
                        </StackPanel>
                        <Button Content="Сохранить сценарий"
                                Click="SaveScenarioButton_Click"
                                HorizontalAlignment="Stretch"
                                Margin="0,8,0,0"/>
                        <TextBlock x:Name="ScenarioStatus"
                                   Text=""
                                   TextWrapping="Wrap"
                                   Foreground="#FFBDBDBD"
                                   Margin="0,8,0,0"/>
                        <Border Background="#FF17181D"
                                BorderBrush="#FF393B44"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="10"
                                Margin="0,8,0,0">
                            <TextBlock x:Name="ScenarioDeviationText"
                                       Text="Проверка отклонений запустится после загрузки сценариев и получения данных MQTT."
                                       TextWrapping="Wrap"
                                       FontSize="12"
                                       Foreground="#FFE8C77A"/>
                        </Border>
                        <Border Background="#FF17181D"
                                BorderBrush="#FF393B44"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="10"
                                Margin="0,8,0,0">
                            <TextBlock x:Name="ScenarioPlanText"
                                       Text="Здесь появится результат проверки и список действий."
                                       TextWrapping="Wrap"
                                       FontSize="12"
                                       Foreground="#FFE0E0E0"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <!-- 6: Diagnostic journal -->
            <PivotItem Header="Журнал">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="14,10,14,12">
                    <StackPanel>
                        <TextBlock Text="Журнал событий"
                                   FontSize="25"
                                   FontWeight="SemiBold"
                                   Foreground="#FFF5F5F5"/>
                        <TextBlock Text="Сообщения MQTT, голосовые команды и результаты проверки сценариев."
                                   Foreground="#FFBDBDBD"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,10"/>
                        <TextBlock x:Name="JournalStatusText" Text="" Foreground="#FF9E9E9E" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                            <Button Content="Поделиться" Click="CopyLogButton_Click" Margin="0,0,8,0"/>
                            <Button Content="Очистить" Click="ClearLogButton_Click"/>
                        </StackPanel>
                        <Border Background="#FF17181D"
                                BorderBrush="#FF393B44"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="10">
                            <TextBlock x:Name="LogText"
                                       TextWrapping="Wrap"
                                       FontSize="13"
                                       Foreground="#FFE0E0E0"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>
        </Pivot>

        <!-- Five familiar destinations from the Android bottom navigation. -->
        <Grid Grid.Row="2" Background="#FF24252A" Height="64">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="NavHomeButton"
                    Grid.Column="0"
                    Click="NavigateHome_Click" Background="Transparent" BorderThickness="0" Padding="0" MinWidth="0" Foreground="#FFBDBDBD">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="⌂" FontSize="21" TextAlignment="Center"/>
                    <TextBlock Text="Главная" FontSize="10" TextAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="NavMarfaButton"
                    Grid.Column="1"
                    Click="MarfaNavigation_Click" Background="Transparent" BorderThickness="0" Padding="0" MinWidth="0" Foreground="#FFBDBDBD">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="🎙" FontSize="21" TextAlignment="Center"/>
                    <TextBlock Text="Марфа" FontSize="10" TextAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="NavCommandsButton"
                    Grid.Column="2"
                    Click="CommandsNavigation_Click" Background="Transparent" BorderThickness="0" Padding="0" MinWidth="0" Foreground="#FFBDBDBD">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="🎤" FontSize="21" TextAlignment="Center"/>
                    <TextBlock Text="Команды" FontSize="10" TextAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="NavHistoryButton"
                    Grid.Column="3"
                    Click="HistoryNavigation_Click" Background="Transparent" BorderThickness="0" Padding="0" MinWidth="0" Foreground="#FFBDBDBD">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="📊" FontSize="21" TextAlignment="Center"/>
                    <TextBlock Text="История" FontSize="10" TextAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="NavPendingButton"
                    Grid.Column="4"
                    Click="PendingNavigation_Click" Background="Transparent" BorderThickness="0" Padding="0" MinWidth="0" Foreground="#FFBDBDBD">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="⏱" FontSize="21" TextAlignment="Center"/>
                    <TextBlock Text="Отложенные" FontSize="10" TextAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Secondary destinations are available from the same menu pattern as Android. -->
        <Popup x:Name="NavigationPopup"
               HorizontalOffset="0"
               VerticalOffset="64">
            <Border Width="260"
                    Background="#FF2B2B2B"
                    BorderBrush="#FF454750"
                    BorderThickness="1"
                    Padding="10">
                <StackPanel>
                    <TextBlock Text="РАЗДЕЛЫ"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#FF9E9E9E"
                               Margin="8,4,8,8"/>
                    <Button Content="Сценарии и логика устройств"
                            HorizontalAlignment="Stretch"
                            Click="MenuScenarios_Click"/>
                    <Button Content="Журнал событий"
                            HorizontalAlignment="Stretch"
                            Click="MenuJournal_Click"/>
                    <Button Content="Настройки"
                            HorizontalAlignment="Stretch"
                            Click="MenuSettings_Click"/>
                    <Button Content="История и графики"
                            HorizontalAlignment="Stretch"
                            Click="MenuHistory_Click"/>
                    <Button Content="Отложенные команды"
                            HorizontalAlignment="Stretch"
                            Click="MenuPending_Click"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>

</Page>
