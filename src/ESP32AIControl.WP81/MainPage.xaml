<Page
    x:Class="ESP32AIControl.WP81.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Page.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF00A4EF"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#FF1B1D24"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#FF9CA3AF"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFF3F4F6"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF252832"/>
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="BorderBrush" Value="#FF343844"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>
    </Page.Resources>
    <Grid Background="#FF101116">
        <Grid.RowDefinitions>
            <RowDefinition Height="68"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <!-- Persistent app header, mirroring the Android top bar. -->
        <Border Grid.Row="0" Background="#FF15171D" BorderBrush="#FF343844"
                BorderThickness="0,0,0,1" Padding="14,5,14,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="ESP32 AI Control" FontSize="23" FontWeight="SemiBold"
                               Foreground="#FF00A4EF" TextWrapping="NoWrap"/>
                    <TextBlock x:Name="PageSubtitle" Text="УПРАВЛЕНИЕ УСТРОЙСТВАМИ"
                               FontSize="10" Foreground="#FF9CA3AF" Margin="1,0,0,0"
                               TextWrapping="NoWrap"/>
                </StackPanel>
                <TextBlock x:Name="TopConnectionDot" Grid.Column="1" Text="●"
                           FontSize="21" Foreground="#FFFFB454"
                           VerticalAlignment="Center" Margin="8,0,2,0"/>
            </Grid>
        </Border>

        <Pivot x:Name="MainPivot" Grid.Row="1" Foreground="#FFF3F4F6"
               Background="#FF101116" SelectionChanged="MainPivot_SelectionChanged">
            <Pivot.HeaderTemplate>
                <DataTemplate>
                    <TextBlock Visibility="Collapsed" Height="0" Width="0"/>
                </DataTemplate>
            </Pivot.HeaderTemplate>
            <PivotItem Header="Управление">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12,6,12,8">
                    <StackPanel>
                        <Border Background="#FF1B1D24" BorderBrush="#FF343844" BorderThickness="1" Padding="12" Margin="0,0,0,12">
                            <TextBlock x:Name="ConnectionText" Text="MQTT: отключено" FontSize="18" Foreground="#FFFFB454"/>
                        </Border>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="ПОДКЛЮЧИТЬ" Click="ConnectButton_Click" Margin="0,0,4,4"/>
                            <Button Grid.Column="1" Content="ОТКЛЮЧИТЬ" Click="DisconnectButton_Click" Margin="4,0,0,4"/>
                        </Grid>
                        <Button Content="ОТПРАВИТЬ HELLO" Click="HelloButton_Click" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>

                        <Border Background="#FF1B1D24" BorderBrush="#FF343844" BorderThickness="1" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <Button x:Name="VoiceButton" Content="🎙  МАРФА — ГОЛОСОВАЯ КОМАНДА" Click="VoiceButton_Click" HorizontalAlignment="Stretch"/>
                                <TextBlock x:Name="VoiceResultText" Text="Например: «Открой теплицу через 20 минут»"
                                           Foreground="#FF9CA3AF" FontSize="14" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="ТЕПЛИЦЫ И УСТРОЙСТВА" FontSize="14" FontWeight="SemiBold" Foreground="#FF00A4EF" Margin="0,14,0,8"/>
                        <Pivot x:Name="WidgetPages" Height="360" Margin="0,0,0,8"/>

                        <TextBlock Text="ЖУРНАЛ СОЕДИНЕНИЯ" FontSize="14" FontWeight="SemiBold" Foreground="#FF00A4EF" Margin="0,18,0,8"/>
                        <Border Background="#FF17191F" BorderBrush="#FF343844" BorderThickness="1" Padding="8" MinHeight="100">
                            <ScrollViewer Height="150">
                                <TextBlock x:Name="LogText" TextWrapping="Wrap" FontSize="13"/>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <PivotItem Header="Графики">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="16,8,16,12">
                    <StackPanel>
                        <TextBlock Text="ГРАФИКИ" FontSize="28" FontWeight="Light" Foreground="#FF00A4EF"/>
                        <TextBlock Text="Запись производится с заданным интервалом, а не по каждому MQTT-пакету."
                                   TextWrapping="Wrap" Opacity="0.7" Margin="0,4,0,10"/>
                        <ComboBox x:Name="GraphWidgetBox" Header="Датчик / виджет" Margin="0,4"/>
                        <StackPanel>
                            <DatePicker x:Name="GraphFrom" Header="Начало периода" Margin="0,4"/>
                            <DatePicker x:Name="GraphTo" Header="Конец периода" Margin="0,4"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,10">
                            <Button Content="Построить" Click="BuildGraphButton_Click" Margin="0,0,8,0"/>
                            <Button Content="Экспорт Word" Click="ExportGraphButton_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="GraphSummary" Text="—" Margin="0,0,0,8"/>
                        <Border BorderThickness="1" Padding="4">
                            <Canvas x:Name="GraphCanvas" Height="340" MinWidth="420"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <PivotItem Header="Задачи">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="16,8,16,12">
                    <StackPanel>
                        <TextBlock Text="ЗАПЛАНИРОВАННЫЕ КОМАНДЫ" FontSize="26" FontWeight="Light" Foreground="#FF00A4EF"/>
                        <TextBlock Text="Команда: device/widget=value" Opacity="0.7" Margin="0,4,0,8"/>
                        <TextBox x:Name="ScheduleCommandBox" Header="Команда"/>
                        <StackPanel Orientation="Horizontal">
                            <DatePicker x:Name="ScheduleDate" Header="Дата" Width="210" Margin="0,4,8,4"/>
                            <TimePicker x:Name="ScheduleTime" Header="Время" Width="210" Margin="8,4,0,4"/>
                        </StackPanel>
                        <Grid Margin="0,4,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Button Content="ДОБАВИТЬ" Click="AddScheduleButton_Click" Margin="0,0,4,4"/>
                            <Button Grid.Column="1" Content="ИЗМЕНИТЬ" Click="UpdateScheduleButton_Click" Margin="4,0,0,4"/>
                            <Button Grid.Row="1" Content="ОТМЕНИТЬ" Click="CancelScheduleButton_Click" Margin="0,4,4,0"/>
                            <Button Grid.Row="1" Grid.Column="1" Content="ОБНОВИТЬ" Click="RefreshScheduleButton_Click" Margin="4,4,0,0"/>
                        </Grid>
                        <ListView x:Name="ScheduleList" Height="420" SelectionChanged="ScheduleList_SelectionChanged"/>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <PivotItem Header="Настройки">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="16,8,16,12">
                    <StackPanel>
                        <TextBlock Text="ПОДКЛЮЧЕНИЕ" FontSize="22" FontWeight="Light" Foreground="#FF00A4EF"/>
                        <TextBox x:Name="HostBox" Header="MQTT host" Text="m4.wqtt.ru"/>
                        <TextBox x:Name="PortBox" Header="TCP port" Text="2815"/>
                        <TextBox x:Name="PrefixBox" Header="MQTT prefix" Text="dghjko"/>
                        <TextBox x:Name="UserNameBox" Header="MQTT username"/>
                        <PasswordBox x:Name="PasswordBox" Header="MQTT password"/>

                        <TextBlock Text="ГРАФИКИ И ХРАНЕНИЕ" FontSize="18" FontWeight="SemiBold" Foreground="#FF00A4EF" Margin="0,20,0,4"/>
                        <TextBox x:Name="MeasurementIntervalBox" Header="Интервал записи, секунд" Text="60"/>
                        <TextBox x:Name="RetentionDaysBox" Header="Период хранения, дней" Text="30"/>
                        <ComboBox x:Name="AutoExportBox" Header="Автоэкспорт Word">
                            <ComboBoxItem Content="Never" Tag="Never"/>
                            <ComboBoxItem Content="1 день" Tag="Day"/>
                            <ComboBoxItem Content="Неделя" Tag="Week"/>
                            <ComboBoxItem Content="Месяц" Tag="Month"/>
                        </ComboBox>

                        <TextBlock Text="ГОЛОСОВОЕ УПРАВЛЕНИЕ" FontSize="18" FontWeight="SemiBold" Foreground="#FF00A4EF" Margin="0,20,0,4"/>
                        <TextBox x:Name="VoiceOpenCommandBox" Header="Команда «открой теплицу»" PlaceholderText="device/widget=1"/>
                        <TextBox x:Name="VoiceCloseCommandBox" Header="Команда «закрой теплицу»" PlaceholderText="device/widget=0"/>

                        <TextBlock Text="СЦЕНАРИЙ IOTMANAGER" FontSize="18" FontWeight="SemiBold" Foreground="#FF00A4EF" Margin="0,20,0,4"/>
                        <TextBlock Text="Вставьте сюда блок scenario=> из export.json. Марфа ищет зависимости от реле вверх по условиям сценария."
                                   TextWrapping="Wrap" Opacity="0.7"/>
                        <TextBox x:Name="ScenarioTextBox"
                                 Header="Сценарий"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Height="220"
                                 />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="Импорт export.json" Click="ImportScenarioButton_Click" Margin="0,0,8,0"/>
                            <Button Content="Проверить план" Click="TestScenarioButton_Click"/>
                        </StackPanel>

                        <Button Content="Сохранить настройки" Click="SaveSettingsButton_Click" Margin="0,12,0,8"/>
                        <TextBlock x:Name="SettingsStatus" Text="" TextWrapping="Wrap"/>

                        <TextBlock Text="ЭКСПОРТ ДАННЫХ" FontSize="18" FontWeight="SemiBold" Foreground="#FF00A4EF" Margin="0,20,0,4"/>
                        <Button Content="Экспорт всей истории за сегодня" Click="ExportTodayButton_Click"/>
                        <TextBlock Text="Документы сохраняются в локальной папке приложения. Формат .doc совместим с Word."
                                   Opacity="0.7" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>
        </Pivot>

        <!-- Fixed bottom navigation inspired by the Android app. -->
        <Grid Grid.Row="2" Background="#FF1B1D24" Padding="3,3,3,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="NavHomeButton" Grid.Column="0" Click="NavigateHome_Click"
                    Height="54" Padding="0" BorderThickness="0" FontSize="11">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="⌂" FontSize="19" HorizontalAlignment="Center"/>
                    <TextBlock Text="Домой" FontSize="10" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="NavMarfaButton" Grid.Column="1" Click="NavigateMarfa_Click"
                    Height="54" Padding="0" BorderThickness="0" FontSize="11">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="◉" FontSize="19" HorizontalAlignment="Center"/>
                    <TextBlock Text="Марфа" FontSize="10" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="NavGraphsButton" Grid.Column="2" Click="NavigateGraphs_Click"
                    Height="54" Padding="0" BorderThickness="0" FontSize="11">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="▥" FontSize="19" HorizontalAlignment="Center"/>
                    <TextBlock Text="Графики" FontSize="10" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="NavTasksButton" Grid.Column="3" Click="NavigateTasks_Click"
                    Height="54" Padding="0" BorderThickness="0" FontSize="11">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="◷" FontSize="19" HorizontalAlignment="Center"/>
                    <TextBlock Text="Задачи" FontSize="10" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="NavSettingsButton" Grid.Column="4" Click="NavigateSettings_Click"
                    Height="54" Padding="0" BorderThickness="0" FontSize="11">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="⚙" FontSize="19" HorizontalAlignment="Center"/>
                    <TextBlock Text="Настройки" FontSize="9" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Page>