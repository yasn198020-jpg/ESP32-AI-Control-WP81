<Page
    x:Class="ESP32AIControl.WP81.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Page.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF00B7FF"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#FF1B1D24"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#FF9CA3AF"/>
        <DataTemplate x:Key="WidgetPageHeaderTemplate">
            <Border Background="#FF30313A" CornerRadius="9" Padding="14,9" Margin="0,0,6,0">
                <TextBlock Text="{Binding}" FontSize="14" FontWeight="SemiBold"
                           FontFamily="Segoe UI Symbol"
                           Foreground="#FFF3F4F6" TextWrapping="NoWrap"/>
            </Border>
        </DataTemplate>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFF3F4F6"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF252832"/>
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="BorderBrush" Value="#FF343844"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF1C1D24"/>
            <Setter Property="Foreground" Value="#FFF3F4F6"/>
            <Setter Property="BorderBrush" Value="#FF3A3B46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#FF1C1D24"/>
            <Setter Property="Foreground" Value="#FFF3F4F6"/>
            <Setter Property="BorderBrush" Value="#FF3A3B46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#FF1C1D24"/>
            <Setter Property="Foreground" Value="#FFF3F4F6"/>
            <Setter Property="BorderBrush" Value="#FF3A3B46"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="ListView">
            <Setter Property="Background" Value="#FF191A20"/>
            <Setter Property="Foreground" Value="#FFF3F4F6"/>
            <Setter Property="BorderBrush" Value="#FF30313A"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Page.Resources>
    <Grid Background="#FF121318">
        <Grid.RowDefinitions>
            <RowDefinition Height="78"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="64"/>
        </Grid.RowDefinitions>

        <!-- Android-like top bar: menu, current screen title, info and MQTT cloud status. -->
        <Border Grid.Row="0" Background="#FF191A20" BorderBrush="#FF30313A"
                BorderThickness="0,0,0,1" Padding="5,7,7,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="38"/>
                    <ColumnDefinition Width="35"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="MenuButton" Grid.Column="0"
                        Click="MenuButton_Click" Background="Transparent"
                        BorderThickness="0" Padding="0"
                        Foreground="#FFF3F4F6" VerticalAlignment="Center"
                        HorizontalAlignment="Center" Width="40" Height="48"
                        AutomationProperties.Name="Открыть меню">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="27">
                        <Border Height="3" Background="#FFF3F4F6" CornerRadius="1" Margin="0,0,0,5"/>
                        <Border Height="3" Background="#FFF3F4F6" CornerRadius="1" Margin="0,0,0,5"/>
                        <Border Height="3" Background="#FFF3F4F6" CornerRadius="1"/>
                    </StackPanel>
                </Button>
                <TextBlock x:Name="PageSubtitle" Grid.Column="1" Text="Главная"
                           FontSize="24" FontWeight="SemiBold" Foreground="#FFF3F4F6"
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           Margin="0,-5,0,0"
                           TextAlignment="Center" TextWrapping="NoWrap"/>
                <Button x:Name="TopInfoButton" Grid.Column="2" Content="ⓘ"
                        Click="TopInfoButton_Click" Background="Transparent"
                        BorderThickness="0" Padding="0" FontSize="22"
                        Foreground="#FFF3F4F6" VerticalAlignment="Stretch"/>
                <TextBlock x:Name="TopConnectionDot" Grid.Column="3" Text="☁"
                           FontSize="25" Foreground="#FFF44336"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid x:Name="MainSections" Grid.Row="1" Background="#FF121318">
<Grid x:Name="HomeSection" Visibility="Visible">
                <Grid Margin="10,0,10,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Page tabs and live widgets are the focus of the Android dashboard. -->
                    <Grid Grid.Row="0">
                        <Pivot x:Name="WidgetPages" Margin="0"
                               HeaderTemplate="{StaticResource WidgetPageHeaderTemplate}"/>
                        <StackPanel x:Name="DashboardEmptyState" VerticalAlignment="Center"
                                    HorizontalAlignment="Center" Margin="24"
                                    IsHitTestVisible="False">
                            <TextBlock Text="Дашборд" FontSize="27" FontWeight="SemiBold"
                                       Foreground="#FF00B7FF" HorizontalAlignment="Center"/>
                            <TextBlock Text="Здесь появятся виджеты теплиц"
                                       FontSize="16" Foreground="#FFF3F4F6"
                                       TextAlignment="Center" Margin="0,12,0,4"/>
                            <TextBlock Text="Откройте меню ☰ и подключитесь к MQTT в настройках."
                                       FontSize="13" Foreground="#FF9CA3AF"
                                       TextAlignment="Center" TextWrapping="Wrap"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- The bottom-nav microphone reports recognition here without taking dashboard space. -->
                    <TextBlock x:Name="VoiceResultText" Grid.Row="1"
                               Text="Голосовое управление: нажмите «Марфа»"
                               Foreground="#FF9CA3AF" FontSize="12"
                               Margin="8,2,8,6" TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Grid>

            <Grid x:Name="GraphsSection" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="16,8,16,12">
                    <StackPanel>
                        <TextBlock Text="ГРАФИКИ" FontSize="28" FontWeight="Light" Foreground="#FF00B7FF"/>
                        <TextBlock Text="Запись производится с заданным интервалом, а не по каждому MQTT-пакету."
                                   TextWrapping="Wrap" Opacity="0.7" Margin="0,4,0,10"/>
                        <ComboBox x:Name="GraphWidgetBox" Header="Датчик / виджет" Margin="0,4"/>
                        <StackPanel>
                            <DatePicker x:Name="GraphFrom" Header="Начало периода" Margin="0,4"/>
                            <DatePicker x:Name="GraphTo" Header="Конец периода" Margin="0,4"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,10">
                            <Button Content="Построить" Click="BuildGraphButton_Click" Margin="0,0,8,0"/>
                            <Button Content="Экспорт Word" Click="ExportGraphButton_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="GraphSummary" Text="—" Margin="0,0,0,8"/>
                        <Border BorderThickness="1" Padding="4">
                            <Canvas x:Name="GraphCanvas" Height="340" MinWidth="420"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid x:Name="TasksSection" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="16,8,16,12">
                    <StackPanel>
                        <TextBlock Text="ЗАПЛАНИРОВАННЫЕ КОМАНДЫ" FontSize="26" FontWeight="Light" Foreground="#FF00B7FF"/>
                        <TextBlock Text="Команда: device/widget=value" Opacity="0.7" Margin="0,4,0,8"/>
                        <TextBox x:Name="ScheduleCommandBox" Header="Команда"/>
                        <StackPanel Orientation="Horizontal">
                            <DatePicker x:Name="ScheduleDate" Header="Дата" Width="210" Margin="0,4,8,4"/>
                            <TimePicker x:Name="ScheduleTime" Header="Время" Width="210" Margin="8,4,0,4"/>
                        </StackPanel>
                        <Grid Margin="0,4,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Button Content="ДОБАВИТЬ" Click="AddScheduleButton_Click" Margin="0,0,4,4"/>
                            <Button Grid.Column="1" Content="ИЗМЕНИТЬ" Click="UpdateScheduleButton_Click" Margin="4,0,0,4"/>
                            <Button Grid.Row="1" Content="ОТМЕНИТЬ" Click="CancelScheduleButton_Click" Margin="0,4,4,0"/>
                            <Button Grid.Row="1" Grid.Column="1" Content="ОБНОВИТЬ" Click="RefreshScheduleButton_Click" Margin="4,4,0,0"/>
                        </Grid>
                        <ListView x:Name="ScheduleList" Height="420" SelectionChanged="ScheduleList_SelectionChanged"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid x:Name="SettingsSection" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12,6,12,8">
                    <StackPanel>
                        <TextBlock Text="НАСТРОЙКИ ПРИЛОЖЕНИЯ" FontSize="18" FontWeight="SemiBold" Foreground="#FF00B7FF" Margin="0,0,0,8"/>
                        <Pivot x:Name="SettingsPivot" Height="490" Background="#FF121318" Foreground="#FFF3F4F6">
                <PivotItem Header="Подключение">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8,0,8,8">
                            <TextBlock Text="ПОДКЛЮЧЕНИЕ" FontSize="22" FontWeight="Light" Foreground="#FF00B7FF"/>
                        <TextBox x:Name="HostBox" Header="MQTT host" Text="m4.wqtt.ru" LostFocus="MqttSetting_LostFocus"/>
                        <TextBox x:Name="PortBox" Header="TCP port" Text="2815" LostFocus="MqttSetting_LostFocus"/>
                        <TextBox x:Name="PrefixBox" Header="MQTT prefix" Text="dghjko" LostFocus="MqttSetting_LostFocus"/>
                        <TextBox x:Name="UserNameBox" Header="MQTT username" LostFocus="MqttSetting_LostFocus"/>
                        <TextBox x:Name="ClientIdBox" Header="MQTT client ID" Text="ESP32-AI-Control-WP81" LostFocus="MqttSetting_LostFocus"/>
                        <PasswordBox x:Name="PasswordBox" Header="MQTT password" LostFocus="MqttSetting_LostFocus"/>
                        <CheckBox x:Name="MqttTlsCheckBox" Content="Использовать защищённое TLS-соединение" Margin="0,8,0,4" Checked="MqttTlsCheckBox_Changed" Unchecked="MqttTlsCheckBox_Changed"/>

                        <TextBlock Text="МАСШТАБ ИНТЕРФЕЙСА" FontSize="18" FontWeight="SemiBold" Foreground="#FF00B7FF" Margin="0,20,0,4"/>
                        <TextBlock Text="Размер текста и элементов интерфейса" Opacity="0.7" TextWrapping="Wrap"/>
                        <Slider x:Name="UiFontScaleSlider" Minimum="0.7" Maximum="1.1" Value="0.85" StepFrequency="0.05" />

                        <Border Background="#FF1B1D24" BorderBrush="#FF343844"
                                BorderThickness="1" Padding="10" Margin="0,8,0,8">
                            <StackPanel>
                                <TextBlock x:Name="ConnectionText" Text="MQTT: отключено"
                                           FontSize="16" Foreground="#FFFFB454" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Content="ПОДКЛЮЧИТЬ" Click="ConnectButton_Click"
                                            Margin="0,0,4,4" Padding="6,8"/>
                                    <Button Grid.Column="1" Content="ОТКЛЮЧИТЬ"
                                            Click="DisconnectButton_Click" Margin="4,0,0,4" Padding="6,8"/>
                                </Grid>
                                <Button Content="ОТПРАВИТЬ HELLO" Click="HelloButton_Click"
                                        HorizontalAlignment="Stretch" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        </StackPanel>
                    </ScrollViewer>
                </PivotItem>
                <PivotItem Header="Хранение">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8,0,8,8">
                            <TextBlock Text="ГРАФИКИ И ХРАНЕНИЕ" FontSize="18" FontWeight="SemiBold" Foreground="#FF00B7FF" Margin="0,20,0,4"/>
                        <TextBox x:Name="MeasurementIntervalBox" Header="Интервал записи, секунд" Text="60"/>
                        <TextBox x:Name="RetentionDaysBox" Header="Период хранения, дней" Text="30"/>
                        <ComboBox x:Name="AutoExportBox" Header="Автоэкспорт Word">
                            <ComboBoxItem Content="Never" Tag="Never"/>
                            <ComboBoxItem Content="1 день" Tag="Day"/>
                            <ComboBoxItem Content="Неделя" Tag="Week"/>
                            <ComboBoxItem Content="Месяц" Tag="Month"/>
                        </ComboBox>
                        </StackPanel>
                    </ScrollViewer>
                </PivotItem>
                <PivotItem Header="Сохранённые">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8,0,8,8">
                            <TextBlock Text="СОХРАНЁННЫЕ MQTT-ПРОФИЛИ" FontSize="18" FontWeight="SemiBold" Foreground="#FF00B7FF" Margin="0,20,0,4"/>
                            <TextBlock Text="Храните подключения к разным серверам или теплицам. Пароль сохраняется вместе с профилем." TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,8"/>
                            <TextBox x:Name="SavedProfileNameBox" Header="Название профиля" PlaceholderText="Например, Основная теплица"/>
                            <ListView x:Name="SavedProfilesList" Height="190" SelectionMode="Single" SelectionChanged="SavedProfilesList_SelectionChanged"/>
                            <Button Content="Сохранить текущие параметры" Click="SaveMqttProfileButton_Click" Margin="0,8,0,4"/>
                            <Button Content="Загрузить выбранный профиль" Click="LoadMqttProfileButton_Click" Margin="0,4"/>
                            <Button Content="Сделать профилем по умолчанию" Click="SetDefaultMqttProfileButton_Click" Margin="0,4"/>
                            <Button Content="Удалить выбранный профиль" Click="DeleteMqttProfileButton_Click" Margin="0,4"/>
                            <TextBlock x:Name="SavedProfilesStatus" Text="" TextWrapping="Wrap" Margin="0,8,0,4"/>
                        </StackPanel>
                    </ScrollViewer>
                </PivotItem>
                <PivotItem Header="Голос">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8,0,8,8">
                            <TextBlock Text="ГОЛОСОВОЕ УПРАВЛЕНИЕ" FontSize="18" FontWeight="SemiBold" Foreground="#FF00B7FF" Margin="0,20,0,4"/>
                        <TextBox x:Name="VoiceOpenCommandBox" Header="Команда «открой теплицу»" PlaceholderText="device/widget=1"/>
                        <TextBox x:Name="VoiceCloseCommandBox" Header="Команда «закрой теплицу»" PlaceholderText="device/widget=0"/>
                        </StackPanel>
                    </ScrollViewer>
                </PivotItem>
                <PivotItem Header="Сценарии">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8,0,8,8">
                            <TextBlock Text="СЦЕНАРИЙ IOTMANAGER" FontSize="18" FontWeight="SemiBold" Foreground="#FF00B7FF" Margin="0,20,0,4"/>
                        <TextBlock Text="Вставьте сюда блок scenario=> из export.json. Марфа ищет зависимости от реле вверх по условиям сценария."
                                   TextWrapping="Wrap" Opacity="0.7"/>
                        <TextBox x:Name="ScenarioTextBox"
                                 Header="Сценарий"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Height="220"
                                 />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="Импорт export.json" Click="ImportScenarioButton_Click" Margin="0,0,8,0"/>
                            <Button Content="Проверить план" Click="TestScenarioButton_Click"/>
                        </StackPanel>


                        </StackPanel>
                    </ScrollViewer>
                </PivotItem>
                <PivotItem Header="Журнал">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8,0,8,8">
                            <TextBlock Text="ЖУРНАЛ СОЕДИНЕНИЯ" FontSize="18" FontWeight="SemiBold"
                                   Foreground="#FF00B7FF" Margin="0,20,0,4"/>
                        <Border Background="#FF17191F" BorderBrush="#FF343844"
                                BorderThickness="1" Padding="8" MinHeight="100">
                            <ScrollViewer Height="150" VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="LogText" TextWrapping="Wrap" FontSize="13"/>
                            </ScrollViewer>
                        </Border>
<TextBlock Text="ЭКСПОРТ ДАННЫХ" FontSize="18" FontWeight="SemiBold" Foreground="#FF00B7FF" Margin="0,20,0,4"/>
                        <Button Content="Экспорт всей истории за сегодня" Click="ExportTodayButton_Click"/>
                        <TextBlock Text="Документы сохраняются в локальной папке приложения. Формат .doc совместим с Word."
                                   Opacity="0.7" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </PivotItem>
                        </Pivot>
                        <Button Content="Сохранить настройки" Click="SaveSettingsButton_Click" Margin="0,12,0,4"/>
                        <Button Content="Сохранить резервную копию в Изображения" Click="ExportSettingsBackupButton_Click" Margin="0,4"/>
                        <Button Content="Восстановить настройки из резервной копии" Click="ImportSettingsBackupButton_Click" Margin="0,4,0,8"/>
                        <TextBlock Text="Файл ESP32-AI-Control-settings-backup.json хранится в общей папке Изображения телефона, вне данных приложения. После переустановки нажмите восстановление." TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,8"/>
                        <TextBlock x:Name="SettingsStatus" Text="" TextWrapping="Wrap"/>
                        
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Fixed bottom navigation inspired by the Android app. -->
        <Border Grid.Row="2" Background="#FF191A20"
                BorderBrush="#FF30313A" BorderThickness="0,1,0,0">
            <Grid Background="#FF191A20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="NavHomeButton" Grid.Column="0" Click="NavigateHome_Click"
                    Height="64" Padding="0" BorderThickness="0" FontSize="11">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="⌂" FontSize="19" HorizontalAlignment="Center"/>
                    <TextBlock Text="Домой" FontSize="10" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="NavMarfaButton" Grid.Column="1" Click="NavigateMarfa_Click"
                    Height="64" Padding="0" BorderThickness="0" FontSize="11"
                    AutomationProperties.Name="Голосовое управление Марфа">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid Width="24" Height="24" HorizontalAlignment="Center">
                        <Border Width="8" Height="14" CornerRadius="4"
                                Background="#FF00B7FF" VerticalAlignment="Top"
                                HorizontalAlignment="Center" Margin="0,1,0,0"/>
                        <Border Width="17" Height="13" CornerRadius="7"
                                BorderBrush="#FF00B7FF" BorderThickness="2"
                                Background="Transparent" VerticalAlignment="Top"
                                HorizontalAlignment="Center" Margin="0,5,0,0"/>
                        <Rectangle Width="2" Height="5" Fill="#FF00B7FF"
                                   VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                   Margin="0,0,0,2"/>
                        <Rectangle Width="10" Height="2" Fill="#FF00B7FF"
                                   VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="Марфа" FontSize="10" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="NavGraphsButton" Grid.Column="2" Click="NavigateGraphs_Click"
                    Height="64" Padding="0" BorderThickness="0" FontSize="11">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="▥" FontSize="19" HorizontalAlignment="Center"/>
                    <TextBlock Text="Графики" FontSize="10" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="NavTasksButton" Grid.Column="3" Click="NavigateTasks_Click"
                    Height="64" Padding="0" BorderThickness="0" FontSize="11">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="◷" FontSize="19" HorizontalAlignment="Center"/>
                    <TextBlock Text="Задачи" FontSize="10" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>

            </Grid>
        </Border>
    </Grid>
</Page>