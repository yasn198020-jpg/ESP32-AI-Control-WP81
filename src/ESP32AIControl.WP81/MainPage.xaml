<Page
    x:Class="ESP32AIControl.WP81.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="20,20,20,10">
            <TextBlock Text="ESP32 AI Control" FontSize="30" />
            <TextBlock Text="Windows Phone 8.1 • Lumia 830" FontSize="16" Opacity="0.7" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="20,10,20,20">
            <TextBlock x:Name="ConnectionText" Text="MQTT: отключено" FontSize="21" Margin="0,0,0,10"/>

            <TextBox x:Name="HostBox" Header="MQTT host" Text="m4.wqtt.ru" Margin="0,4,0,4"/>
            <TextBox x:Name="PortBox" Header="TCP port" Text="2815" Margin="0,4,0,4"/>
            <TextBox x:Name="PrefixBox" Header="MQTT prefix" Text="dghjko" Margin="0,4,0,10"/>

            <StackPanel Orientation="Horizontal">
                <Button Content="Подключить" Click="ConnectButton_Click" Margin="0,0,8,0"/>
                <Button Content="Отключить" Click="DisconnectButton_Click" Margin="8,0,0,0"/>
            </StackPanel>

            <Button Content="HELLO" Click="HelloButton_Click" Margin="0,12,0,12"/>

            <TextBlock Text="MQTT / ESP32 log" FontSize="18" Margin="0,4,0,6"/>
            <ScrollViewer Height="280">
                <TextBlock x:Name="LogText" TextWrapping="Wrap" FontSize="15"/>
            </ScrollViewer>
        </StackPanel>
    </Grid>
</Page>
