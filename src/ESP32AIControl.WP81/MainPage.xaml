<Page
    x:Class="ESP32AIControl.WP81.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="20,16,20,8">
            <TextBlock Text="ESP32 AI Control" FontSize="30"/>
            <TextBlock Text="Windows Phone 8.1 • Lumia 830" FontSize="16" Opacity="0.7"/>
            <TextBlock x:Name="ConnectionText" Text="MQTT: отключено" FontSize="20" Margin="0,8,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      Margin="20,8,20,12"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBox x:Name="HostBox" Header="MQTT host" Text="m4.wqtt.ru" Margin="0,4,0,4"/>
                <TextBox x:Name="PortBox" Header="TCP port" Text="2815" Margin="0,4,0,4"/>
                <TextBox x:Name="PrefixBox" Header="MQTT prefix" Text="dghjko" Margin="0,4,0,4"/>
                <TextBox x:Name="UserNameBox" Header="MQTT username" Margin="0,4,0,4"/>
                <PasswordBox x:Name="PasswordBox" Header="MQTT password" Margin="0,4,0,8"/>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Подключить" Click="ConnectButton_Click" Margin="0,0,8,0"/>
                    <Button Content="Отключить" Click="DisconnectButton_Click" Margin="8,0,0,0"/>
                </StackPanel>

                <Button Content="HELLO" Click="HelloButton_Click" Margin="0,10,0,14"/>

                <TextBlock Text="Устройства и виджеты" FontSize="21" Margin="0,0,0,8"/>
                <StackPanel x:Name="WidgetHost"/>

                <TextBlock Text="MQTT / ESP32 log" FontSize="19" Margin="0,16,0,6"/>
                <Border BorderThickness="1" Padding="6" MinHeight="120">
                    <ScrollViewer Height="220">
                        <TextBlock x:Name="LogText" TextWrapping="Wrap" FontSize="14"/>
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>