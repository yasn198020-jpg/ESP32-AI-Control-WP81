<Page
    x:Class="ESP32AIControl.WP81.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="20,20,20,10">
            <TextBlock Text="ESP32 AI Control" FontSize="32" />
            <TextBlock Text="Windows Phone 8.1" FontSize="18" Opacity="0.7" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="20,10,20,20">
            <TextBlock x:Name="ConnectionText" Text="MQTT: не подключено" FontSize="22" Margin="0,0,0,16"/>
            <Button x:Name="HelloButton" Content="HELLO" Click="HelloButton_Click" Margin="0,0,0,12"/>
            <TextBlock Text="Последние сообщения" FontSize="20" Margin="0,10,0,8"/>
            <ScrollViewer>
                <TextBlock x:Name="LogText" TextWrapping="Wrap" FontSize="16"/>
            </ScrollViewer>
        </StackPanel>
    </Grid>
</Page>
