<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/2010/manifest"
         xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest">
  <Identity Name="ESP32AIControl.WP81"
            Publisher="CN=yasn198020-jpg"
            Version="2.0.0.0" />
  <mp:PhoneIdentity PhoneProductId="9A7C6E32-7B8D-4DCE-9B0A-4D9B9B8B0A81"
                    PhonePublisherId="00000000-0000-0000-0000-000000000000" />
  <Properties>
    <DisplayName>ESP32 AI Control</DisplayName>
    <PublisherDisplayName>yasn198020-jpg</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Resources>
    <Resource Language="x-generate" />
  </Resources>
  <Prerequisites>
    <OSMinVersion>6.3.1</OSMinVersion>
    <OSMaxVersionTested>6.3.1</OSMaxVersionTested>
  </Prerequisites>
  <Applications>
    <Application Id="App"
                 Executable="$targetnametoken$.exe"
                 EntryPoint="ESP32AIControl.WP81.App">
      <VisualElements DisplayName="ESP32 AI Control"
                       Logo="Assets\Square150x150Logo.png"
                       SmallLogo="Assets\Square44x44Logo.png"
                       Description="ESP32 MQTT client"
                       ForegroundText="light"
                       BackgroundColor="#464646">
        <DefaultTile ShortName="ESP32 AI Control" />
        <SplashScreen Image="Assets\SplashScreen.png" />
      </VisualElements>
    </Application>
  </Applications>
  <Capabilities>
    <Capability Name="internetClient" />
    <Capability Name="microphone" />
  </Capabilities>
</Package>