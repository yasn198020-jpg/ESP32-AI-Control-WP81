<Project ToolsVersion="12.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">ARM</Platform>
    <ProjectGuid>{9A7C6E32-7B8D-4DCE-9B0A-4D9B9B8B0A81}</ProjectGuid>
    <OutputType>AppContainerExe</OutputType>
    <RootNamespace>ESP32AIControl.WP81</RootNamespace>
    <AssemblyName>ESP32-AI-Control-WP81</AssemblyName>
    <TargetPlatformIdentifier>WindowsPhone</TargetPlatformIdentifier>
    <TargetPlatformVersion>8.1</TargetPlatformVersion>
    <TargetPlatformMinVersion>8.1</TargetPlatformMinVersion>
    <MinimumVisualStudioVersion>12.0</MinimumVisualStudioVersion>
    <TargetFrameworkIdentifier>.NETFramework</TargetFrameworkIdentifier>
    <TargetFrameworkVersion>v4.5</TargetFrameworkVersion>
    <TargetFrameworkMoniker>.NETFramework,Version=v4.5</TargetFrameworkMoniker>
    <DefaultLanguage>ru-RU</DefaultLanguage>
    <AppxManifest>Package.appxmanifest</AppxManifest>
    <AppxPackageSigningEnabled>False</AppxPackageSigningEnabled>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|ARM'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE;NETFX_CORE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|ARM'">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE;NETFX_CORE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <ItemGroup>
    <AppxManifest Include="Package.appxmanifest" />
    <Content Include="Assets\**\*.*" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="App.xaml.cs" />
    <Compile Include="MainPage.xaml.cs">
      <DependentUpon>MainPage.xaml</DependentUpon>
    </Compile>
    <Compile Include="Core\**\*.cs" />
    <Compile Include="Models\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Page Include="App.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Include="MainPage.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Code</SubType>
    </Page>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Runtime.WindowsRuntime" />
    <Reference Include="Windows" />
  </ItemGroup>

  <!-- VS 2022 keeps the Windows Phone 8.1 XAML targets under WindowsXaml\v17.0\8.1.
       Older WP8.1 Visual Studio installations use the legacy VisualStudio\v$(VisualStudioVersion) path. -->
  <Import Project="$(MSBuildExtensionsPath32)\Microsoft\WindowsXaml\v$(VisualStudioVersion)\8.1\Microsoft.Windows.UI.Xaml.CSharp.Targets"
          Condition="Exists('$(MSBuildExtensionsPath32)\Microsoft\WindowsXaml\v$(VisualStudioVersion)\8.1\Microsoft.Windows.UI.Xaml.CSharp.Targets')" />
  <Import Project="$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v$(VisualStudioVersion)\WindowsXaml\Microsoft.Windows.UI.Xaml.CSharp.targets"
          Condition="Exists('$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v$(VisualStudioVersion)\WindowsXaml\Microsoft.Windows.UI.Xaml.CSharp.targets')" />
<!-- WP8.1 performs a temporary C# compile between XAML markup passes.
       The .NET 4.5 reference DLLs must be visible to that C# compile, but not
       remain in ReferencePath during XAML Pass2 because the legacy XAML compiler
       treats them as metadata inputs and can fail with WMC9999. -->
  <Target Name="WP81AddNet45FrameworkReferencesForXamlPreCompile"
          AfterTargets="MarkupCompilePass1"
          BeforeTargets="XamlPreCompile">
    <ItemGroup>
      <_WP81FrameworkReferences Include="$(FrameworkPathOverride)\mscorlib.dll"
                                Condition="Exists('$(FrameworkPathOverride)\mscorlib.dll')" />
      <_WP81FrameworkReferences Include="$(FrameworkPathOverride)\System.dll"
                                Condition="Exists('$(FrameworkPathOverride)\System.dll')" />
      <_WP81FrameworkReferences Include="$(FrameworkPathOverride)\System.Core.dll"
                                Condition="Exists('$(FrameworkPathOverride)\System.Core.dll')" />
      <_WP81FrameworkReferences Include="$(FrameworkPathOverride)\System.Runtime.dll"
                                Condition="Exists('$(FrameworkPathOverride)\System.Runtime.dll')" />
      <_WP81FrameworkReferences Include="$(FrameworkPathOverride)\System.Runtime.Serialization.dll"
                                Condition="Exists('$(FrameworkPathOverride)\System.Runtime.Serialization.dll')" />

      <_WP81UniversalContractForXamlPreCompile Include="@(ReferencePath)"
          Condition="'%(ReferencePath.Filename)%(ReferencePath.Extension)' == 'Windows.Foundation.UniversalApiContract.winmd'" />
      <_WP81UniversalContractForXamlPreCompileWithRefs Include="@(ReferencePathWithRefAssemblies)"
          Condition="'%(ReferencePathWithRefAssemblies.Filename)%(ReferencePathWithRefAssemblies.Extension)' == 'Windows.Foundation.UniversalApiContract.winmd'" />

      <ReferencePath Remove="@(_WP81UniversalContractForXamlPreCompile)" />
      <ReferencePathWithRefAssemblies Remove="@(_WP81UniversalContractForXamlPreCompileWithRefs)" />

      <ReferencePath Include="@(_WP81FrameworkReferences)" />
      <ReferencePathWithRefAssemblies Include="@(_WP81FrameworkReferences)" />
    </ItemGroup>
  </Target>

  <Target Name="WP81RemoveNet45FrameworkReferencesBeforeXamlPass2"
          AfterTargets="XamlPreCompile"
          BeforeTargets="MarkupCompilePass2">
    <ItemGroup>
      <ReferencePath Remove="@(_WP81FrameworkReferences)" />
      <ReferencePathWithRefAssemblies Remove="@(_WP81FrameworkReferences)" />
    </ItemGroup>
  </Target>

  <Target Name="WP81AddNet45FrameworkReferencesForCoreCompile"
          AfterTargets="MarkupCompilePass2;_BeforeVBCSCoreCompile"
          BeforeTargets="CoreCompile">
    <ItemGroup>
      <ReferencePath Include="@(_WP81FrameworkReferences)" />
      <ReferencePathWithRefAssemblies Include="@(_WP81FrameworkReferences)" />

      <!-- Windows.winmd is the WP8.1 API surface used by this project.
           UniversalApiContract.winmd overlaps it and causes CS0433 during
           the final C# compile, while it remains valid for the XAML stages. -->
      <_WP81UniversalContractForCoreCompile Include="@(ReferencePath)"
          Condition="'%(ReferencePath.Filename)%(ReferencePath.Extension)' == 'Windows.Foundation.UniversalApiContract.winmd'" />
      <_WP81UniversalContractForCoreCompileWithRefs Include="@(ReferencePathWithRefAssemblies)"
          Condition="'%(ReferencePathWithRefAssemblies.Filename)%(ReferencePathWithRefAssemblies.Extension)' == 'Windows.Foundation.UniversalApiContract.winmd'" />
      <ReferencePath Remove="@(_WP81UniversalContractForCoreCompile)" />
      <ReferencePathWithRefAssemblies Remove="@(_WP81UniversalContractForCoreCompileWithRefs)" />
    </ItemGroup>
  </Target>

  </Project>
