<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  IgnorableNamespaces="uap mp">
  <Identity Name="WP81Smoke"
            Publisher="CN=WP81Smoke"
            Version="1.0.0.0" />
  <Properties>
    <DisplayName>WP81 Smoke</DisplayName>
    <PublisherDisplayName>WP81 Smoke</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Resources>
    <Resource Language="en-US" />
  </Resources>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Mobile" MinVersion="8.1" MaxVersionTested="8.1" />
  </Dependencies>
  <Applications>
    <Application Id="App"
                 Executable="$targetnametoken$.exe"
                 EntryPoint="WP81Smoke.App">
      <uap:VisualElements AppListEntry="none"
                          DisplayName="WP81 Smoke"
                          Square150x150Logo="Assets\Logo.png"
                          Square44x44Logo="Assets\SmallLogo.png"
                          Description="WP81 XAML smoke test" />
    </Application>
  </Applications>
  <Capabilities>
    <Capability Name="internetClient" />
  </Capabilities>
</Package>
